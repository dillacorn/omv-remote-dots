# Dockge using a Tailscale Serve sidecar.
# Expected URL:
# https://dockge.example-tailnet.ts.net

COMPOSE_PROJECT_NAME=dockge

# Service Configuration
SERVICE=dockge
IMAGE_URL=louislam/dockge:1

# Dockge listens on 5001 by default
SERVICEPORT=5001

# Dockge Configuration
DOCKGE_STACKS_DIR=/docker

# Tailscale Configuration
# Example:
# TS_AUTHKEY=tskey-client-xxxxxxxxxxxxxxxx
TS_AUTHKEY=

# Optional
TZ=America/New_York
