# /docker/immich/.env

COMPOSE_PROJECT_NAME=immich

# Service Configuration
SERVICE=immich

# Immich server listens on 2283 by default
SERVICEPORT=2283

# Tailscale Configuration
# Example:
# TS_AUTHKEY=tskey-client-xxxxxxxxxxxxxxxx
TS_AUTHKEY=

# Immich Configuration
UPLOAD_LOCATION=/srv/mergerfs/data/root/immich/library
DB_DATA_LOCATION=./postgres
TZ=America/New_York
IMMICH_VERSION=release

# Immich Database
DB_PASSWORD=postgres
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# Optional external library path
#EXTERNAL_PATH=/srv/mergerfs/data/root/immich_external_library