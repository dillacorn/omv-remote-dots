# /docker/navidrome/.env

COMPOSE_PROJECT_NAME=navidrome

# Service Configuration
SERVICE=navidrome
IMAGE_URL=deluan/navidrome:latest
SERVICEPORT=4533

# Tailscale Configuration
# Example:
# TS_AUTHKEY=tskey-client-xxxxxxxxxxxxxxxx
TS_AUTHKEY=

# Navidrome Container Configuration
NAVIDROME_UID=1000
NAVIDROME_GID=1000
TZ=America/New_York

# Host Paths
DATA_PATH=./data
MUSIC_PATH=/srv/mergerfs/data/root/Music
