COMPOSE_PROJECT_NAME=owncast
TZ=America/New_York

# Owncast
OWNCAST_IMAGE=ich777/owncast:latest
OWNCAST_CONTAINER_NAME=owncast
OWNCAST_DATA_PATH=./data
OWNCAST_FFMPEG_PATH=./ffmpeg

# Direct LAN access
OWNCAST_LAN_WEB_PORT=1930
OWNCAST_LAN_RTMP_PORT=1935

# Tailscale
TAILSCALE_IMAGE=tailscale/tailscale:latest
TAILSCALE_CONTAINER_NAME=owncast-tailscale
TS_HOSTNAME=owncast
TS_STATE_PATH=./ts/state
TS_CONFIG_PATH=./ts/config

# Paste a one-time or reusable pre-authorized auth key here for first startup.
TS_AUTHKEY=tskey-auth-INSERT_YOUR_KEY

# Example only when your Tailscale ACL requires this tag:
# TS_EXTRA_ARGS=--advertise-tags=tag:container
TS_EXTRA_ARGS=

# NVIDIA
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility,video