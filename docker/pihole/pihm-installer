#!/usr/bin/env bash
# pihm-installer - install/update the Pi-hole profile manager TUI
#
# Installs managed files under /docker/pihole and exposes the short command:
#   pihm
#
# Overrides:
#   PIHM_REPO=dillacorn/omv-remote-dots
#   PIHM_REF=main
#   PIHM_HOME=/docker/pihole
#   PIHM_BINDIR=/usr/local/bin
#   PIHM_COMMAND=pihm

set -euo pipefail

REPO="${PIHM_REPO:-dillacorn/omv-remote-dots}"
DEST="${PIHM_HOME:-/docker/pihole}"
BINDIR="${PIHM_BINDIR:-/usr/local/bin}"
COMMAND="${PIHM_COMMAND:-pihm}"
SOURCE_REF_FILE="$DEST/.pihm-source-ref"
ACTION="${1:-install}"

REF="${PIHM_REF:-}"
if [[ -z "$REF" && -f "$SOURCE_REF_FILE" ]]; then
  REF="$(cat "$SOURCE_REF_FILE")"
fi
REF="${REF:-main}"
RAW_BASE="https://raw.githubusercontent.com/${REPO}/${REF}/docker/pihole"

FILES=(
  pihole-profile-manager
  pihole-profile-tui
  profile-catalog.ini
  profile.example.ini
  pihm-installer
  pihm-web-installer
)

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "Required command not found: $1"
}

if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
  die "Run this installer as root (or with sudo)."
fi

case "$ACTION" in
  install|update|uninstall) ;;
  *)
    die "Usage: pihm-installer [install|update|uninstall]"
    ;;
esac

if [[ "$ACTION" == "uninstall" ]]; then
  if [[ -e /etc/systemd/system/pihm-web.service || -e "$DEST/pihm-web" ]]; then
    die "pihm-web is installed. Remove it first with: pihm-web-installer uninstall"
  fi

  rm -f "$BINDIR/$COMMAND" "$BINDIR/pihm-installer" "$BINDIR/pihm-web-installer"
  rm -f \
    "$DEST/pihole-profile-manager" \
    "$DEST/pihole-profile-tui" \
    "$DEST/profile-catalog.ini" \
    "$DEST/profile.example.ini" \
    "$DEST/pihm-installer" \
    "$DEST/pihm-web-installer" \
    "$SOURCE_REF_FILE"

  printf 'Removed pihm program files and command links.\n'
  printf 'Preserved Pi-hole data, gravity.db, profiles.d, backups, and Compose files.\n'
  exit 0
fi

need python3
need install
need mktemp

SCRIPT_SOURCE="${BASH_SOURCE[0]:-}"
SCRIPT_DIR=""

# When invoked as an actual file, allow installing from the checked-out/local
# directory. When piped via "curl ... | bash", BASH_SOURCE is empty; never
# mistake the current working directory for the installer source.
if [[ -n "$SCRIPT_SOURCE" && -f "$SCRIPT_SOURCE" ]]; then
  SCRIPT_DIR="$(
    cd -- "$(dirname -- "$SCRIPT_SOURCE")" >/dev/null 2>&1 && pwd
  )"
fi

LOCAL_SOURCE=0
# "update" must always fetch the current remote files. Otherwise an installed
# /docker/pihole/pihm-installer would simply copy the already-installed files
# back over themselves and never update.
if [[ "$ACTION" == "install" &&
      -n "$SCRIPT_DIR" &&
      -f "$SCRIPT_DIR/pihole-profile-manager" &&
      -f "$SCRIPT_DIR/pihole-profile-tui" &&
      -f "$SCRIPT_DIR/profile-catalog.ini" &&
      -f "$SCRIPT_DIR/profile.example.ini" &&
      -f "$SCRIPT_DIR/pihm-installer" &&
      -f "$SCRIPT_DIR/pihm-web-installer" ]]; then
  LOCAL_SOURCE=1
else
  need curl
fi

mkdir -p "$DEST" "$DEST/profiles.d" "$BINDIR"

stage="$(mktemp -d)"
cleanup() {
  rm -rf -- "$stage"
}
trap cleanup EXIT

printf 'pihm installer\n'
printf '  source: %s@%s\n' "$REPO" "$REF"
printf '  home:   %s\n' "$DEST"
printf '  command: %s/%s\n\n' "$BINDIR" "$COMMAND"

for f in "${FILES[@]}"; do
  if (( LOCAL_SOURCE )); then
    [[ -f "$SCRIPT_DIR/$f" ]] || {
      [[ "$f" == "pihm-installer" ]] || die "Missing local source file: $SCRIPT_DIR/$f"
      cp -- "$SCRIPT_SOURCE" "$stage/$f"
      continue
    }
    cp -- "$SCRIPT_DIR/$f" "$stage/$f"
  else
    curl -fsSL -H 'Cache-Control: no-cache' "$RAW_BASE/$f" -o "$stage/$f"
  fi
done

python3 -m py_compile   "$stage/pihole-profile-manager"   "$stage/pihole-profile-tui"

bash -n "$stage/pihm-installer" "$stage/pihm-web-installer"

stamp="$(date '+%Y%m%d-%H%M%S')"
for f in pihole-profile-manager pihole-profile-tui profile-catalog.ini profile.example.ini pihm-installer pihm-web-installer; do
  if [[ -e "$DEST/$f" ]] && ! cmp -s "$stage/$f" "$DEST/$f"; then
    cp -a -- "$DEST/$f" "$DEST/${f}.backup-${stamp}"
    printf 'Backup: %s\n' "$DEST/${f}.backup-${stamp}"
  fi
done

install -m 0755 "$stage/pihole-profile-manager" "$DEST/pihole-profile-manager"
install -m 0755 "$stage/pihole-profile-tui" "$DEST/pihole-profile-tui"
install -m 0644 "$stage/profile-catalog.ini" "$DEST/profile-catalog.ini"
install -m 0644 "$stage/profile.example.ini" "$DEST/profile.example.ini"
install -m 0755 "$stage/pihm-installer" "$DEST/pihm-installer"
install -m 0755 "$stage/pihm-web-installer" "$DEST/pihm-web-installer"

ln -sfn "$DEST/pihole-profile-manager" "$BINDIR/$COMMAND"
ln -sfn "$DEST/pihm-installer" "$BINDIR/pihm-installer"
ln -sfn "$DEST/pihm-web-installer" "$BINDIR/pihm-web-installer"
printf '%s\n' "$REF" >"$SOURCE_REF_FILE"

printf '\nInstalled successfully.\n'
printf 'Source ref: %s\n' "$REF"
printf 'Run the TUI from anywhere with:\n\n'
printf '  %s\n\n' "$COMMAND"
printf 'Future updates are built into the TUI:\n\n'
printf '  pihm -> Update pihm\n\n'
printf 'Optional browser UI management is available in:\n\n'
printf '  pihm -> Web interface\n\n'
printf 'Profile files remain in: %s/profiles.d\n' "$DEST"
