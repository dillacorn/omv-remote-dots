            "/default", {"profile": p["name"]}, "Make default"
        )
        sync = action_form("/sync", {"profile": p["name"]}, "Sync")
        profile_cards.append(
            f"""<div class="card">
              <div class="card-title">{h(p["name"])} {default}</div>
              <div class="muted">{p["lists"]} blocklists · {len(p["clients"])} client addresses</div>
              <div class="actions">{set_default}{sync}</div>
            </div>"""
        )

    assigned_rows = []
    for item in sorted(assigned, key=lambda x: (x["profile"].casefold(), x["address"])):
        remove = action_form("/unassign", {"address": item["address"]}, "Remove")
        assigned_rows.append(
            f"""<tr>
              <td>{h(item["label"] or "—")}</td>
              <td><code>{h(item["address"])}</code></td>
              <td><code>{h(item["mac"] or "—")}</code></td>
              <td>{h(item["profile"])}</td>
