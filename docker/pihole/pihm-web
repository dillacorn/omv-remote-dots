def device_group_name(label: str, address: str) -> str:
    name = (label or "").strip()
    for suffix in (" - LAN", " - Tailscale"):
        if name.casefold().endswith(suffix.casefold()):
            name = name[: -len(suffix)].rstrip()
            break
    return name or address


def grouped_profile_devices(profile: dict) -> list[dict]:
    groups: dict[str, dict] = {}
    for address, label in profile["clients"]:
        name = device_group_name(label, address)
        key = name.casefold()
        item = groups.setdefault(key, {"name": name, "addresses": []})
        item["addresses"].append({"address": address, "label": label})
    return sorted(groups.values(), key=lambda item: item["name"].casefold())


