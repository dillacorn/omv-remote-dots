def fail(message: str) -> None:
    raise RuntimeError(message)


def run(argv: list[str], timeout: int = 10) -> str:
    try:
        return subprocess.check_output(
            argv,
            text=True,
            stderr=subprocess.DEVNULL,
            timeout=timeout,
        ).strip()
    except Exception:
        return ""


def run_checked(argv: list[str], timeout: int = 45) -> None:
    subprocess.run(argv, check=True, timeout=timeout)


def pihole_api_auth_url() -> str:
    if PIHOLE_API_URL:
        base = PIHOLE_API_URL.rstrip("/")
        return base if base.endswith("/api/auth") else f"{base}/api/auth"

    raw = run(["docker", "inspect", PIHOLE_CONTAINER])
    if not raw:
        return ""

    try:
        items = json.loads(raw)
        info = items[0] if isinstance(items, list) and items else {}
    except Exception:
        return ""

    network = info.get("NetworkSettings", {}) if isinstance(info, dict) else {}
    bindings = network.get("Ports", {}).get("80/tcp") or []
    for binding in bindings:
        if not isinstance(binding, dict):
            continue
        host_port = str(binding.get("HostPort") or "").strip()
        if not host_port:
            continue
        host_ip = str(binding.get("HostIp") or "").strip()
        if host_ip in {"", "0.0.0.0", "::"}:
            host_ip = "127.0.0.1"
        host = f"[{host_ip}]" if ":" in host_ip else host_ip
        return f"http://{host}:{host_port}/api/auth"

    candidates = []
    direct_ip = str(network.get("IPAddress") or "").strip()
    if direct_ip:
        candidates.append(direct_ip)
    for data in (network.get("Networks") or {}).values():
        if isinstance(data, dict):
            value = str(data.get("IPAddress") or "").strip()
            if value:
                candidates.append(value)

    if candidates:
        return f"http://{candidates[0]}:80/api/auth"
    return ""


def pihole_password_valid(password: str) -> bool:
    url = pihole_api_auth_url()
    if not url:
        return False

    payload = json.dumps({"password": password}).encode("utf-8")
    request = urllib.request.Request(
        url,
        data=payload,
        method="POST",
        headers={"Content-Type": "application/json"},
    )

    try:
        with urllib.request.urlopen(request, timeout=5) as response:
            if response.status != HTTPStatus.OK:
                return False
            body = json.loads(response.read().decode("utf-8"))
    except Exception:
        return False

    session = body.get("session", {}) if isinstance(body, dict) else {}
    valid = session.get("valid") is True
    sid = str(session.get("sid") or "").strip()

    if sid:
        logout = urllib.request.Request(
            url,
            method="DELETE",
            headers={"X-FTL-SID": sid},
        )
        try:
            urllib.request.urlopen(logout, timeout=5).close()
        except Exception:
            pass

    return valid


def load_profile(path: Path) -> dict:
    cfg = configparser.ConfigParser(interpolation=None)
    cfg.optionxform = str
    with path.open(encoding="utf-8") as fh:
        cfg.read_file(fh)

    name = cfg.get("profile", "name", fallback=path.stem).strip() or path.stem
    is_default = cfg.getboolean("profile", "default", fallback=False)
    clients = []
    for raw in cfg.get("clients", "entries", fallback="").splitlines():
        raw = raw.strip()
        if not raw or raw.startswith(("#", ";")):
            continue
        address, sep, label = raw.partition("|")
        clients.append((address.strip(), label.strip() if sep else ""))

    keys = [
        x.strip()
        for x in cfg.get("lists", "keys", fallback="").splitlines()
        if x.strip() and not x.lstrip().startswith(("#", ";"))
    ]

    def values(section: str, option: str) -> list[str]:
        return [
            x.strip()
            for x in cfg.get(section, option, fallback="").splitlines()
            if x.strip() and not x.lstrip().startswith(("#", ";"))
        ]

    return {
        "path": path,
        "name": name,
        "description": cfg.get("profile", "description", fallback="Managed Pi-hole profile").strip(),
        "default": is_default,
        "clients": clients,
        "keys": keys,
        "lists": len(keys),
        "extra_urls": values("lists", "extra_urls"),
        "allow": values("allow", "domains"),
        "deny": values("deny", "domains"),
        "tlds": values("deny", "tlds"),
        "proxy_enabled": cfg.getboolean("proxy", "enabled", fallback=False),
        "proxy_port": cfg.get("proxy", "port", fallback="").strip(),
        "proxy_ip": cfg.get("proxy", "docker_ip", fallback="").strip(),
        "proxy_label": cfg.get("proxy", "label", fallback="").strip(),
    }


def profiles() -> list[dict]:
    PROFILES.mkdir(parents=True, exist_ok=True)
    out = []
    for path in sorted(PROFILES.glob("*.ini")):
        try:
            out.append(load_profile(path))
        except Exception:
            continue
    return out


def profile_by_name(name: str) -> dict:
    matches = [p for p in profiles() if p["name"] == name]
    if len(matches) != 1:
        fail("profile not found")
    return matches[0]


def catalog_entries() -> dict[str, str]:
    if not CATALOG.is_file():
        return {}
    cfg = configparser.ConfigParser(interpolation=None)
    cfg.optionxform = str
    try:
        with CATALOG.open(encoding="utf-8") as fh:
            cfg.read_file(fh)
    except Exception:
        return {}
    out = {}
    for key in cfg.sections():
        comment = cfg.get(key, "comment", fallback=key).strip() or key
        if cfg.get(key, "url", fallback="").strip():
            out[key] = comment
    return out


def clean_lines(value: str) -> list[str]:
    return [
        line.strip()
        for line in value.splitlines()
        if line.strip() and not line.lstrip().startswith(("#", ";"))
    ]


def write_profile_settings(
    profile: dict,
    description: str,
    keys: list[str],
    extra_urls: list[str],
    allow: list[str],
    deny: list[str],
    tlds: list[str],
) -> None:
    known = catalog_entries()
    bad = [key for key in keys if key not in known]
    if bad:
        fail("unknown blocklist keys: " + ", ".join(bad))
    description = description.strip()
    if not description:
        fail("description cannot be empty")

    cfg = configparser.ConfigParser(interpolation=None)
    cfg.optionxform = str
    with profile["path"].open(encoding="utf-8") as fh:
        cfg.read_file(fh)

    for section in ("profile", "lists", "allow", "deny"):
        if not cfg.has_section(section):
            cfg.add_section(section)

    cfg.set("profile", "description", description)
    cfg.set("lists", "keys", "\n" + "\n".join(keys))
    cfg.set("lists", "extra_urls", "\n" + "\n".join(extra_urls))
    cfg.set("allow", "domains", "\n" + "\n".join(allow))
    cfg.set("deny", "domains", "\n" + "\n".join(deny))
    cfg.set("deny", "tlds", "\n" + "\n".join(tlds))

    import io
    buf = io.StringIO()
    cfg.write(buf)
    profile["path"].write_text(buf.getvalue(), encoding="utf-8")


def write_proxy_settings(
    profile: dict,
    enabled: bool,
    port: str,
    docker_ip: str,
    label: str,
) -> None:
    cfg = configparser.ConfigParser(interpolation=None)
    cfg.optionxform = str
    with profile["path"].open(encoding="utf-8") as fh:
        cfg.read_file(fh)
    if not cfg.has_section("proxy"):
        cfg.add_section("proxy")

    if enabled:
        if not port.isdigit() or not (1024 <= int(port) <= 65535):
            fail("proxy port must be between 1024 and 65535")
        try:
            if ipaddress.ip_address(docker_ip).version != 4:
                fail("proxy Docker IP must be IPv4")
        except ValueError:
            fail("proxy Docker IP must be valid IPv4")
        for other in profiles():
            if other["name"] == profile["name"] or not other["proxy_enabled"]:
                continue
            if str(other["proxy_port"]) == port:
                fail(f"proxy port {port} is already used by {other['name']}")
            if other["proxy_ip"] == docker_ip:
                fail(f"proxy Docker IP {docker_ip} is already used by {other['name']}")
        cfg.set("proxy", "enabled", "true")
        cfg.set("proxy", "port", port)
        cfg.set("proxy", "docker_ip", docker_ip)
        cfg.set("proxy", "label", label.strip())
    else:
        cfg.set("proxy", "enabled", "false")
        cfg.set("proxy", "port", "")
        cfg.set("proxy", "docker_ip", "")
        cfg.set("proxy", "label", "")

    import io
    buf = io.StringIO()
    cfg.write(buf)
    profile["path"].write_text(buf.getvalue(), encoding="utf-8")


def rfc1918_ipv4(value: str) -> bool:
    try:
        ip = ipaddress.ip_address(value)
    except ValueError:
        return False
    if ip.version != 4:
        return False
    return (
        ip in ipaddress.ip_network("10.0.0.0/8")
        or ip in ipaddress.ip_network("172.16.0.0/12")
        or ip in ipaddress.ip_network("192.168.0.0/16")
    )


def direct_lan_networks() -> list[ipaddress.IPv4Network]:
    networks = []
    raw = run(["ip", "-4", "route", "show", "scope", "link"])
    for line in raw.splitlines():
        parts = line.split()
        if not parts:
            continue
        dev = ""
        if "dev" in parts:
            try:
                dev = parts[parts.index("dev") + 1]
            except (ValueError, IndexError):
                dev = ""
        if dev in {"lo", "tailscale0"} or dev.startswith(("docker", "br-", "veth")):
            continue
        try:
            net = ipaddress.ip_network(parts[0], strict=False)
        except ValueError:
            continue
        if isinstance(net, ipaddress.IPv4Network) and rfc1918_ipv4(str(net.network_address)):
            networks.append(net)
    return networks


def is_direct_lan_ip(value: str, networks: list[ipaddress.IPv4Network] | None = None) -> bool:
    if not rfc1918_ipv4(value):
        return False
    nets = direct_lan_networks() if networks is None else networks
    if not nets:
        return True
    ip = ipaddress.ip_address(value)
    return any(ip in net for net in nets)


def neighbor_map() -> dict[str, str]:
    out: dict[str, str] = {}
    for line in run(["ip", "neigh", "show"]).splitlines():
        parts = line.split()
        if not parts:
            continue
        try:
            ipaddress.ip_address(parts[0])
        except ValueError:
            continue
        if "lladdr" not in parts:
            continue
        try:
            out[parts[0]] = parts[parts.index("lladdr") + 1].lower()
        except (ValueError, IndexError):
            pass
    return out


def recent_lan_clients() -> list[dict]:
    found: dict[str, dict] = {}
    macs = neighbor_map()
    local_networks = direct_lan_networks()

    if FTL_DB.is_file():
        try:
            db = sqlite3.connect(f"file:{FTL_DB}?mode=ro", uri=True)
            db.row_factory = sqlite3.Row
            tables = {r[0] for r in db.execute("SELECT name FROM sqlite_master WHERE type='table'")}
            if "network_addresses" in tables:
                cols = {r[1] for r in db.execute("PRAGMA table_info(network_addresses)")}
                if "ip" in cols:
                    name_expr = "name" if "name" in cols else "''"
                    seen_expr = "lastSeen" if "lastSeen" in cols else "0"
                    query = f"SELECT ip,{name_expr} AS name,{seen_expr} AS lastSeen FROM network_addresses"
                    for row in db.execute(query):
                        value = str(row["ip"] or "")
                        try:
                            ip = ipaddress.ip_address(value)
                        except ValueError:
                            continue
                        if ip.version != 4 or not is_direct_lan_ip(value, local_networks):
                            continue
                        found[value] = {
                            "ip": value,
                            "name": str(row["name"] or ""),
                            "last_seen": int(row["lastSeen"] or 0),
                            "mac": macs.get(value, ""),
                        }
            db.close()
        except Exception:
            pass

    for value, mac in macs.items():
        try:
            ip = ipaddress.ip_address(value)
        except ValueError:
            continue
        if ip.version != 4 or not is_direct_lan_ip(value, local_networks):
            continue
        found.setdefault(
            value,
            {"ip": value, "name": "", "last_seen": 0, "mac": mac},
        )
        if mac:
            found[value]["mac"] = mac

    def sort_key(item: dict):
        parts = tuple(int(x) for x in item["ip"].split("."))
        return (-int(item["last_seen"] or 0), parts)

    return sorted(found.values(), key=sort_key)


def normalize_device_name(value: str) -> str:
    value = (value or "").strip().rstrip(".").split(".", 1)[0].casefold()
    import re
    value = re.sub(r"[-_.]\d+$", "", value)
    return re.sub(r"[^a-z0-9]+", "", value)


def private_ip_from_endpoint(value: str) -> str:
    value = (value or "").strip()
    if not value:
        return ""
    if value.startswith("["):
        host = value[1:].split("]", 1)[0]
    else:
        host = value.rsplit(":", 1)[0] if ":" in value else value
    return host if rfc1918_ipv4(host) else ""


def tailscale_devices() -> list[dict]:
    raw = run(["tailscale", "status", "--json"])
    if not raw:
        return []
    try:
        data = json.loads(raw)
    except Exception:
        return []

    peers = data.get("Peer", {})
    nodes = list(peers.values()) if isinstance(peers, dict) else list(peers or [])
    out = []

    for node in nodes:
        ipv4 = ""
        for value in node.get("TailscaleIPs") or []:
            try:
                ip = ipaddress.ip_address(value)
            except ValueError:
                continue
            if ip.version == 4:
                ipv4 = str(ip)
                break
        if not ipv4:
            continue

        dns = str(node.get("DNSName") or "").rstrip(".")
        host = str(node.get("HostName") or "").strip()
        name = host or (dns.split(".", 1)[0] if dns else ipv4)
        lan_candidates = []
        direct = private_ip_from_endpoint(str(node.get("CurAddr") or ""))
        if direct and is_direct_lan_ip(direct):
            lan_candidates.append(direct)
        for endpoint in node.get("Addrs") or []:
            candidate = private_ip_from_endpoint(str(endpoint))
            if candidate and is_direct_lan_ip(candidate) and candidate not in lan_candidates:
                lan_candidates.append(candidate)

        out.append({
            "name": name,
            "dns": dns,
            "ip": ipv4,
            "lan_candidates": lan_candidates,
            "online": bool(node.get("Online", False)),
        })

    return sorted(out, key=lambda d: (not d["online"], d["name"].casefold()))


def load_secondary_tailnets() -> list[dict]:
    if not TAILNETS_FILE.is_file():
        return []
    try:
        data = json.loads(TAILNETS_FILE.read_text(encoding="utf-8"))
    except Exception:
        return []
    rows = data.get("tailnets", []) if isinstance(data, dict) else []
    out = []
    for item in rows:
        if not isinstance(item, dict):
            continue
        label = str(item.get("label") or "").strip()
        tailnet = str(item.get("tailnet") or "").strip()
        client_id = str(item.get("client_id") or "").strip()
        client_secret = str(item.get("client_secret") or "").strip()
        if label and tailnet and client_id and client_secret:
            out.append({
                "label": label,
                "tailnet": tailnet,
                "client_id": client_id,
                "client_secret": client_secret,
            })
    return out


def save_secondary_tailnets(rows: list[dict]) -> None:
    TAILNETS_FILE.parent.mkdir(parents=True, exist_ok=True)
    tmp = TAILNETS_FILE.with_name(
        f".{TAILNETS_FILE.name}.tmp-{os.getpid()}-{secrets.token_hex(4)}"
    )
    payload = json.dumps({"tailnets": rows}, indent=2) + "\n"
    try:
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(payload)
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, TAILNETS_FILE)
        os.chmod(TAILNETS_FILE, 0o600)
    finally:
        try:
            tmp.unlink()
        except FileNotFoundError:
            pass


def tailscale_oauth_token(entry: dict) -> str:
    payload = urlencode({
        "grant_type": "client_credentials",
        "client_id": entry["client_id"],
        "client_secret": entry["client_secret"],
    }).encode("utf-8")
    request = urllib.request.Request(
        "https://api.tailscale.com/api/v2/oauth/token",
        data=payload,
        method="POST",
        headers={"Content-Type": "application/x-www-form-urlencoded"},
    )
    with urllib.request.urlopen(request, timeout=8) as response:
        body = json.loads(response.read().decode("utf-8"))
    return str(body.get("access_token") or "").strip()


def secondary_tailnet_devices(entry: dict) -> list[dict]:
    token = tailscale_oauth_token(entry)
    if not token:
        fail(f"{entry['label']}: Tailscale OAuth token request failed")
    tailnet = quote(entry["tailnet"], safe="")
    request = urllib.request.Request(
        f"https://api.tailscale.com/api/v2/tailnet/{tailnet}/devices",
        headers={"Authorization": f"Bearer {token}"},
    )
    with urllib.request.urlopen(request, timeout=8) as response:
        body = json.loads(response.read().decode("utf-8"))

    devices = body.get("devices", []) if isinstance(body, dict) else []
    out = []
    for node in devices if isinstance(devices, list) else []:
        if not isinstance(node, dict):
            continue
        ipv4 = ""
        for value in node.get("addresses") or []:
            try:
                ip = ipaddress.ip_address(str(value))
            except ValueError:
                continue
            if ip.version == 4:
                ipv4 = str(ip)
                break
        if not ipv4:
            continue
        hostname = str(node.get("hostname") or "").strip()
        fqdn = str(node.get("name") or "").strip().rstrip(".")
        name = hostname or (fqdn.split(".", 1)[0] if fqdn else ipv4)
        out.append({
            "name": name,
            "dns": fqdn,
            "ip": ipv4,
            "tailnet": entry["label"],
            "last_seen": str(node.get("lastSeen") or ""),
        })
    return sorted(out, key=lambda item: item["name"].casefold())


def cached_secondary_tailnet_devices(entry: dict) -> list[dict]:
    key = "|".join((entry["label"], entry["tailnet"], entry["client_id"]))
    cached = SECONDARY_TAILNET_CACHE.get(key)
    now = time.monotonic()
    if cached and now - cached[0] < SECONDARY_TAILNET_CACHE_SECONDS:
        return cached[1]
    devices = secondary_tailnet_devices(entry)
    SECONDARY_TAILNET_CACHE[key] = (now, devices)
    return devices


def clear_secondary_tailnet_cache() -> None:
    SECONDARY_TAILNET_CACHE.clear()


def all_tailscale_devices() -> tuple[list[dict], list[dict]]:
    devices = []
    for item in tailscale_devices():
        devices.append({
            **item,
            "tailnet": "Local tailnet",
            "last_seen": "",
            "source": "local",
        })

    states = []
    for entry in load_secondary_tailnets():
        try:
            remote = cached_secondary_tailnet_devices(entry)
            devices.extend({**item, "online": False, "source": "api"} for item in remote)
            states.append({
                "label": entry["label"],
                "tailnet": entry["tailnet"],
                "count": len(remote),
                "error": "",
            })
        except Exception as exc:
            states.append({
                "label": entry["label"],
                "tailnet": entry["tailnet"],
                "count": 0,
                "error": str(exc),
            })

    seen = set()
    unique = []
    for item in devices:
        key = (item.get("tailnet", ""), item.get("ip", ""))
        if key in seen:
            continue
        seen.add(key)
        unique.append(item)
    return unique, states


def address_matches_client(address: str, client_ip: str) -> bool:
    try:
        ip = ipaddress.ip_address(client_ip)
    except ValueError:
        return False
    try:
        if "/" in address:
            return ip in ipaddress.ip_network(address, strict=False)
        return ip == ipaddress.ip_address(address)
    except ValueError:
        return False


def recent_dns_clients() -> list[dict]:
    if not FTL_DB.is_file():
        return []
    cutoff = int(time.time()) - ACTIVE_CLIENT_WINDOW
    try:
        db = sqlite3.connect(f"file:{FTL_DB}?mode=ro", uri=True)
        db.row_factory = sqlite3.Row
        tables = {r[0] for r in db.execute("SELECT name FROM sqlite_master WHERE type='table'")}
        if "queries" not in tables:
            db.close()
            return []
        cols = {r[1] for r in db.execute("PRAGMA table_info(queries)")}
        if not {"timestamp", "client"}.issubset(cols):
            db.close()
            return []
        rows = db.execute(
            "SELECT client, MAX(timestamp) AS last_seen, COUNT(*) AS query_count "
            "FROM queries WHERE timestamp >= ? GROUP BY client",
            (cutoff,),
        ).fetchall()
        db.close()
    except Exception:
        return []

    out = []
    for row in rows:
        value = str(row["client"] or "").strip()
        try:
            ipaddress.ip_address(value)
        except ValueError:
            continue
        out.append({
            "ip": value,
            "last_seen": int(row["last_seen"] or 0),
            "queries": int(row["query_count"] or 0),
        })
    return sorted(out, key=lambda item: (-item["last_seen"], item["ip"]))


def live_client_group_rules() -> list[tuple[str, str]]:
    if not GRAVITY_DB.is_file():
        return []
    try:
        db = sqlite3.connect(f"file:{GRAVITY_DB}?mode=ro", uri=True)
        rows = db.execute(
            'SELECT c.ip,g.name FROM client c '
            'JOIN client_by_group x ON x.client_id=c.id '
            'JOIN "group" g ON g.id=x.group_id '
            'ORDER BY c.id,g.id'
        ).fetchall()
        db.close()
    except Exception:
        return []
    return [(str(row[0] or "").strip(), str(row[1] or "").strip()) for row in rows]


def profile_activity(ps: list[dict]) -> tuple[dict[str, int], list[dict]]:
    counts = {p["name"]: 0 for p in ps}
    known_profiles = set(counts)
    default_name = next((p["name"] for p in ps if p["default"]), "")
    rules = live_client_group_rules()
    rows = []

    for item in recent_dns_clients():
        groups = []
        for address, group_name in rules:
            if address_matches_client(address, item["ip"]) and group_name not in groups:
                groups.append(group_name)

        non_default = [name for name in groups if name and name != "Default"]
        if non_default:
            effective = " + ".join(non_default)
            for name in non_default:
                if name in known_profiles:
                    counts[name] += 1
        else:
            effective = default_name or "Pi-hole Default"
            if effective in counts:
                counts[effective] += 1

        rows.append({**item, "profile": effective})

    return counts, rows


def age_text(value: int) -> str:
    if not value:
        return "seen on LAN"
    age = max(0, int(time.time()) - int(value))
    if age < 60:
        return "just now"
    if age < 3600:
        return f"{age // 60}m ago"
    if age < 86400:
        return f"{age // 3600}h ago"
    return f"{age // 86400}d ago"


