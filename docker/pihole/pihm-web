def dashboard_script() -> str:
    return """
(function () {
  function closeAll() {
    document.querySelectorAll('.modal.open').forEach(function (m) {
      m.classList.remove('open');
      m.setAttribute('aria-hidden','true');
    });
    document.body.classList.remove('modal-open');
  }

  function openModal(id, profile) {
    var modal = document.getElementById(id);
    if (!modal) return;
    closeAll();
    if (profile) {
      modal.querySelectorAll('select[data-profile-select]').forEach(function (sel) {
        for (var i = 0; i < sel.options.length; i++) {
          if (sel.options[i].value === profile) {
            sel.selectedIndex = i;
            break;
          }
        }
      });
    }
    modal.classList.add('open');
    modal.setAttribute('aria-hidden','false');
    document.body.classList.add('modal-open');
    var focus = modal.querySelector('input[type=search],input:not([type=hidden]),select,button');
    if (focus) setTimeout(function () { focus.focus(); }, 50);
  }

  document.addEventListener('click', function (event) {
    var opener = event.target.closest('[data-open-modal]');
    if (opener) {
      event.preventDefault();
      openModal(opener.getAttribute('data-open-modal'), opener.getAttribute('data-profile') || '');
      return;
    }
    var closer = event.target.closest('[data-close-modal]');
    if (closer) {
      event.preventDefault();
      closeAll();
      return;
    }
    if (event.target.classList.contains('modal')) closeAll();
  });

  document.addEventListener('keydown', function (event) {
    if (event.key === 'Escape') closeAll();
  });

  document.querySelectorAll('[data-filter-input]').forEach(function (input) {
    input.addEventListener('input', function () {
      var zone = input.closest('[data-filter-zone]');
      if (!zone) return;
      var query = input.value.trim().toLowerCase();
      zone.querySelectorAll('[data-filter-item]').forEach(function (item) {
        var haystack = (item.getAttribute('data-search') || item.textContent || '').toLowerCase();
        item.style.display = !query || haystack.indexOf(query) !== -1 ? '' : 'none';
      });
    });
  });

  var auto = document.body.getAttribute('data-auto-open');
  if (auto) openModal(auto, '');
})();
"""


def modal_shell(modal_id: str, title: str, body: str, wide: bool = False) -> str:
    cls = "modal-panel wide" if wide else "modal-panel"
    return f"""<div class="modal" id="{h(modal_id)}" aria-hidden="true">
      <section class="{cls}" role="dialog" aria-modal="true" aria-labelledby="{h(modal_id)}-title">
        <header class="modal-head">
          <h2 id="{h(modal_id)}-title">{h(title)}</h2>
          <button type="button" class="modal-close" data-close-modal aria-label="Close">×</button>
        </header>
        <div class="modal-body">{body}</div>
      </section>
    </div>"""


def profile_settings_modal(profile: dict) -> str:
    p = profile
    catalog = catalog_entries()
    selected = set(p["keys"])
    checks = []
    for key, comment in catalog.items():
        checked = " checked" if key in selected else ""
        checks.append(
            f'<label class="check" data-filter-item data-search="{h(key + " " + comment)}">'
            f'<input type="checkbox" name="keys" value="{h(key)}"{checked}> '
            f'<strong>{h(key)}</strong> <span class="muted">{h(comment)}</span></label>'
        )

    clients = []
    for address, label in p["clients"]:
        clients.append(
            f"""<tr data-filter-item data-search="{h(address + " " + label)}">
              <td>
                <form method="post" action="/profile/client-save" class="inline">
                  <input type="hidden" name="csrf" value="{h(CSRF)}">
                  <input type="hidden" name="profile" value="{h(p["name"])}">
                  <input type="hidden" name="old_address" value="{h(address)}">
                  <input name="address" value="{h(address)}" required>
                  <input name="label" value="{h(label)}" placeholder="Label">
                  <button type="submit">Save</button>
                </form>
              </td>
              <td>{action_form("/profile/client-delete", {"profile": p["name"], "address": address}, "Delete")}</td>
            </tr>"""
        )

    live_description = live_group_description(p["name"])
    suggested_port, suggested_ip = next_proxy_slot(p["name"])
    proxy_checked = " checked" if p["proxy_enabled"] else ""
    proxy_info = ""
    if p["proxy_enabled"]:
        info = proxy_runtime_info(p)
        proxy_info = f"""<div class="compact-list" style="margin-top:8px">
          <div class="compact-row"><strong>Container</strong><code>{h(info["label"])}</code><span>{h(info["state"])}</span></div>
          <div class="compact-row"><strong>Preferred host</strong><code>{h(info["hostname"])}:{h(p["proxy_port"])}</code><span></span></div>
          <div class="compact-row"><strong>LAN</strong><code>{h(info["lan_ip"])}:{h(p["proxy_port"])}</code><span></span></div>
          <div class="compact-row"><strong>Tailscale</strong><code>{h(info["tail_ip"])}:{h(p["proxy_port"])}</code><span></span></div>
        </div>"""

    return_to = profile_return(p["name"])
    default_action = (
        '<span class="tag">DEFAULT</span>'
        if p["default"]
        else action_form("/default", {"profile": p["name"], "return_to": return_to}, "Make default")
    )
    sync = action_form("/sync", {"profile": p["name"], "return_to": return_to}, "Sync")
    gravity = action_form("/sync-gravity", {"profile": p["name"], "return_to": return_to}, "Sync + refresh")

    body = f"""
      <div class="modal-actions">
        {default_action}
        {sync}
        {gravity}
        <button type="button" data-open-modal="{h(devices_modal_id(p["name"]))}">Devices</button>
        <button type="button" data-open-modal="add-device" data-profile="{h(p["name"])}">Add device</button>
      </div>

      <h3>Rename</h3>
      <form method="post" action="/profile/rename" class="inline">
        <input type="hidden" name="csrf" value="{h(CSRF)}">
        <input type="hidden" name="profile" value="{h(p["name"])}">
        <input name="name" value="{h(p["name"])}" required>
        <button type="submit">Rename profile</button>
      </form>
      <div class="hint">The live Pi-hole group is renamed too when it exists. Backups are created first.</div>

      <form method="post" action="/profile/save">
        <input type="hidden" name="csrf" value="{h(CSRF)}">
        <input type="hidden" name="profile" value="{h(p["name"])}">

        <div class="field">
          <label>Description</label>
          <input name="description" value="{h(p["description"])}" style="width:100%" required>
          <div class="hint">Live Pi-hole description: {h(live_description or "none")}</div>
        </div>

        <details>
          <summary>Blocklists · {len(p["keys"])} selected</summary>
          <div data-filter-zone style="margin-top:8px">
            <input class="filter" type="search" placeholder="Filter blocklists" data-filter-input>
            <div class="check-list" style="margin-top:6px">{''.join(checks) or '<div class="empty">No catalog entries found.</div>'}</div>
          </div>
          <div class="field">
            <label>Extra blocklist URLs</label>
            <textarea name="extra_urls">{h(chr(10).join(p["extra_urls"]))}</textarea>
          </div>
        </details>

        <details>
          <summary>Domain and TLD rules · {len(p["allow"])} allow / {len(p["deny"])} deny / {len(p["tlds"])} TLD</summary>
          <div class="split">
            <div class="field"><label>Allowed domains</label><textarea name="allow">{h(chr(10).join(p["allow"]))}</textarea></div>
            <div class="field"><label>Denied domains</label><textarea name="deny">{h(chr(10).join(p["deny"]))}</textarea></div>
            <div class="field"><label>Blocked TLDs</label><textarea name="tlds">{h(chr(10).join(p["tlds"]))}</textarea></div>
          </div>
        </details>

        <div class="modal-actions"><button type="submit">Save profile</button></div>
      </form>

      <form method="post" action="/profile/restore-description" class="inline">
        <input type="hidden" name="csrf" value="{h(CSRF)}">
        <input type="hidden" name="profile" value="{h(p["name"])}">
        <button type="submit">Restore description from Pi-hole</button>
      </form>

      <details>
        <summary>Saved client addresses</summary>
        <div data-filter-zone style="margin-top:8px">
          <input class="filter" type="search" placeholder="Filter saved clients" data-filter-input>
          {('<div class="table-wrap" style="margin-top:6px"><table><thead><tr><th>Address / label</th><th></th></tr></thead><tbody>' + ''.join(clients) + '</tbody></table></div>') if clients else '<div class="empty" style="margin-top:6px">No explicit client addresses.</div>'}
        </div>
      </details>

      <details>
        <summary>Arachnidium endpoint</summary>
        <form method="post" action="/profile/proxy" style="margin-top:8px">
          <input type="hidden" name="csrf" value="{h(CSRF)}">
          <input type="hidden" name="profile" value="{h(p["name"])}">
          <label><input type="checkbox" name="enabled" value="1"{proxy_checked}> Enable reserved endpoint</label>
          <div class="toolbar">
            <input name="port" value="{h(p["proxy_port"] or suggested_port)}" placeholder="Port">
            <input name="docker_ip" value="{h(p["proxy_ip"] or suggested_ip)}" placeholder="Docker IP">
            <input name="label" value="{h(p["proxy_label"])}" placeholder="Container label">
            <button type="submit">Save endpoint</button>
          </div>
          <div class="hint">This reserves metadata only. It does not deploy or force Arachnidium.</div>
        </form>
        {proxy_info}
      </details>

      <details>
        <summary>Clone profile</summary>
        <form method="post" action="/profile/clone" class="inline" style="margin-top:8px">
          <input type="hidden" name="csrf" value="{h(CSRF)}">
          <input type="hidden" name="profile" value="{h(p["name"])}">
          <input name="name" placeholder="New profile name" required>
          <button type="submit">Clone</button>
        </form>
      </details>

      <details>
        <summary>Raw INI</summary>
        <pre><code>{h(p["path"].read_text(encoding="utf-8"))}</code></pre>
      </details>
    """
    return modal_shell(profile_modal_id(p["name"]), f"Edit: {p['name']}", body, wide=True)


def profile_devices_modal(profile: dict, activity: list[dict]) -> str:
    groups = grouped_profile_devices(profile)
    rows = []
    for group in groups:
        addresses = "<br>".join(
            f'<code>{h(item["address"])}</code>'
            + (f' <span class="muted">{h(item["label"])}</span>' if item["label"] else "")
            for item in group["addresses"]
        )
        rows.append(
            f"""<tr data-filter-item data-search="{h(group["name"] + " " + " ".join(x["address"] for x in group["addresses"]))}">
              <td><strong>{h(group["name"])}</strong></td>
              <td>{addresses}</td>
            </tr>"""
        )

    recent = [item for item in activity if profile["name"] in item.get("profiles", [])]
    body = f"""
      <div class="modal-actions">
        <button type="button" data-open-modal="add-device" data-profile="{h(profile["name"])}">Add device</button>
        <button type="button" data-open-modal="{h(profile_modal_id(profile["name"]))}">Edit profile</button>
      </div>
      <div data-filter-zone>
        <input class="filter" type="search" placeholder="Filter devices" data-filter-input>
        {('<div class="table-wrap" style="margin-top:8px"><table><thead><tr><th>Device</th><th>Saved identities</th></tr></thead><tbody>' + ''.join(rows) + '</tbody></table></div>') if rows else '<div class="empty" style="margin-top:8px">No devices are explicitly saved to this profile.</div>'}
      </div>
      <div class="hint" style="margin-top:8px">
        Saved devices are grouped by their labels, so one physical device can show both LAN and Tailscale identities together.
        The Default fallback can legitimately have zero saved devices while still serving many recent DNS sources.
      </div>
      <h3>Recent activity using this policy</h3>
      <div class="hint">{len(recent)} source addresses seen during the rolling last 24 hours.</div>
    """
    return modal_shell(devices_modal_id(profile["name"]), f"Devices: {profile['name']}", body)


def profile_recent_modal(profile: dict, activity: list[dict], names: dict[str, str]) -> str:
    recent = [item for item in activity if profile["name"] in item.get("profiles", [])]
    rows = []
    for item in recent:
        rows.append(
            f"""<tr data-filter-item data-search="{h(names.get(item["ip"], "") + " " + item["ip"])}">
              <td>{h(names.get(item["ip"], "—"))}</td>
              <td><code>{h(item["ip"])}</code></td>
              <td>{h(age_text(item["last_seen"]))}</td>
              <td>{item["queries"]}</td>
            </tr>"""
        )
    body = f"""
      <div class="hint">This is recent DNS activity, not a count of devices currently online. One device can appear under more than one source address.</div>
      <div data-filter-zone style="margin-top:8px">
        <input class="filter" type="search" placeholder="Filter recent sources" data-filter-input>
        {('<div class="table-wrap" style="margin-top:8px"><table><thead><tr><th>Name</th><th>Source address</th><th>Last query</th><th>Queries</th></tr></thead><tbody>' + ''.join(rows) + '</tbody></table></div>') if rows else '<div class="empty" style="margin-top:8px">No DNS source addresses were seen using this policy during the last 24 hours.</div>'}
      </div>
    """
    return modal_shell(recent_modal_id(profile["name"]), f"Recent activity: {profile['name']}", body)


def render(message: str = "", error: bool = False, theme: str = DEFAULT_THEME, open_modal: str = "") -> str:
    ps = profiles()
    activity_counts, dns_activity = profile_activity(ps)
    lan_clients = recent_lan_clients()
    macs = neighbor_map()
    tail_devices, tailnet_states = all_tailscale_devices()

    assigned_addresses = {
        address
        for p in ps
        for address, _ in p["clients"]
    }

    name_by_ip: dict[str, str] = {}
    for item in lan_clients:
        if item.get("name"):
            name_by_ip[item["ip"]] = item["name"]
    for item in tail_devices:
        if item.get("name"):
            name_by_ip[item["ip"]] = item["name"]

    profile_cards = []
    modals = []

    for p in ps:
        groups = grouped_profile_devices(p)
        default = '<span class="tag">DEFAULT</span>' if p["default"] else ""
        proxy = f' · proxy :{h(p["proxy_port"])}' if p["proxy_enabled"] else ""
        search_blob = p["name"] + " " + p["description"]

        card_actions = [
            f'<button type="button" data-open-modal="{h(profile_modal_id(p["name"]))}">Edit</button>',
            f'<button type="button" data-open-modal="{h(devices_modal_id(p["name"]))}">Devices {len(groups)}</button>',
            f'<button type="button" data-open-modal="{h(recent_modal_id(p["name"]))}">Recent {activity_counts.get(p["name"], 0)}</button>',
            action_form("/sync", {"profile": p["name"]}, "Sync"),
        ]
        if not p["default"]:
            card_actions.append(action_form("/default", {"profile": p["name"]}, "Make default"))

        profile_cards.append(
            f"""<article class="profile-card" data-filter-item data-search="{h(search_blob)}">
              <div class="profile-name">{h(p["name"])}{default}</div>
              <div class="profile-meta">{p["lists"]} blocklists{proxy}</div>
              <div class="card-actions">{''.join(card_actions)}</div>
            </article>"""
        )

        modals.append(profile_settings_modal(p))
        modals.append(profile_devices_modal(p, dns_activity))
        modals.append(profile_recent_modal(p, dns_activity, name_by_ip))

    assigned_rows = []
    for p in ps:
        for address, label in p["clients"]:
            assigned_rows.append(
                f"""<tr data-filter-item data-search="{h((label or "") + " " + address + " " + p["name"])}">
                  <td>{h(device_group_name(label, address))}</td>
                  <td><code>{h(address)}</code></td>
                  <td>{h(p["name"])}</td>
                </tr>"""
            )

    recent_rows = []
    for item in dns_activity:
        recent_rows.append(
            f"""<tr data-filter-item data-search="{h(name_by_ip.get(item["ip"], "") + " " + item["ip"] + " " + item["profile"])}">
              <td>{h(name_by_ip.get(item["ip"], "—"))}</td>
              <td><code>{h(item["ip"])}</code></td>
              <td>{h(item["profile"])}</td>
              <td>{h(age_text(item["last_seen"]))}</td>
              <td>{item["queries"]}</td>
            </tr>"""
        )

    all_devices_body = f"""
      <div data-filter-zone>
        <input class="filter" type="search" placeholder="Search devices, addresses, or profiles" data-filter-input>
        <h3>Saved assignments</h3>
        {('<div class="table-wrap"><table><thead><tr><th>Device</th><th>Address</th><th>Profile</th></tr></thead><tbody>' + ''.join(assigned_rows) + '</tbody></table></div>') if assigned_rows else '<div class="empty">No saved client assignments.</div>'}
        <h3>Recent DNS sources</h3>
        <div class="hint">Rolling last 24 hours. This is source-address activity, not a physical-device count.</div>
        {('<div class="table-wrap" style="margin-top:6px"><table><thead><tr><th>Name</th><th>Address</th><th>Live policy</th><th>Last query</th><th>Queries</th></tr></thead><tbody>' + ''.join(recent_rows) + '</tbody></table></div>') if recent_rows else '<div class="empty" style="margin-top:6px">No recent DNS sources found.</div>'}
      </div>
    """
    modals.append(modal_shell("all-devices", "All devices", all_devices_body, wide=True))

    add_rows = []
    for item in lan_clients:
        if item["ip"] in assigned_addresses:
            continue
        reserve = (
            f'{item["mac"]} · reserve this IPv4/MAC on the router'
            if item["mac"]
            else "MAC not currently visible"
        )
        add_rows.append(
            f"""<tr data-filter-item data-search="{h((item.get("name") or "") + " " + item["ip"] + " " + item.get("mac",""))}">
              <td>{h(item.get("name") or "Unknown")}</td>
              <td>LAN</td>
              <td><code>{h(item["ip"])}</code><div class="hint">{h(reserve)}</div></td>
              <td>
                <form method="post" action="/assign" class="inline">
                  <input type="hidden" name="csrf" value="{h(CSRF)}">
                  <input type="hidden" name="address" value="{h(item["ip"])}">
                  <input type="hidden" name="label" value="{h(item.get("name") or "LAN device")}">
                  <select name="profile" data-profile-select>{profile_options()}</select>
                  <button type="submit">Assign</button>
                </form>
              </td>
            </tr>"""
        )

    recent_dns_addresses = {item["ip"] for item in dns_activity}
    for item in tail_devices:
        if item["ip"] in assigned_addresses:
            continue
        if item.get("source") == "local":
            lan_match, lan_reason = auto_lan_for_tail_device(item, lan_clients)
            action = f"""<form method="post" action="/profile/link-local-device" class="inline">
              <input type="hidden" name="csrf" value="{h(CSRF)}">
              <input type="hidden" name="device" value="{h(item["ip"])}">
              <select name="profile" data-profile-select>{profile_options()}</select>
              <button type="submit" name="mode" value="save">Link</button>
              <button type="submit" name="mode" value="sync">Link + sync</button>
            </form>"""
            state = "Online" if item.get("online") else "Offline"
            if lan_match:
                state += f" · LAN {lan_match} ({lan_reason})"
            else:
                state += " · no confident LAN match"
        else:
            verified = item["ip"] in recent_dns_addresses
            if verified:
                action = f"""<form method="post" action="/assign" class="inline">
                  <input type="hidden" name="csrf" value="{h(CSRF)}">
                  <input type="hidden" name="address" value="{h(item["ip"])}">
                  <input type="hidden" name="label" value="{h(item["name"] + " - Tailscale")}">
                  <select name="profile" data-profile-select>{profile_options()}</select>
                  <button type="submit">Assign</button>
                </form>"""
                state = "Verified DNS source"
            else:
                action = '<span class="muted">Send DNS through Pi-hole first</span>'
                state = item.get("last_seen") or "Discovered by API"

        add_rows.append(
            f"""<tr data-filter-item data-search="{h(item["name"] + " " + item["ip"] + " " + item.get("tailnet",""))}">
              <td>{h(item["name"])}</td>
              <td>{h(item.get("tailnet") or "Tailscale")}</td>
              <td><code>{h(item["ip"])}</code><div class="hint">{h(state)}</div></td>
              <td>{action}</td>
            </tr>"""
        )

    manual_add = f"""
      <details>
        <summary>Find by Tailscale / MagicDNS name</summary>
        <form method="post" action="/profile/link-local-device-name" class="toolbar" style="margin-top:8px">
          <input type="hidden" name="csrf" value="{h(CSRF)}">
