def form_one(data: dict[str, list[str]], key: str) -> str:
    values = data.get(key) or [""]
    return values[0] if values else ""


class Handler(BaseHTTPRequestHandler):
    server_version = "pihm-web"

    def log_message(self, fmt: str, *args) -> None:
        sys.stderr.write("%s - %s\n" % (self.address_string(), fmt % args))

    def current_theme(self) -> str:
        raw = self.headers.get("Cookie", "")
        if not raw:
            return DEFAULT_THEME
        try:
            cookie = SimpleCookie()
            cookie.load(raw)
            item = cookie.get("pihm_theme")
            value = item.value if item is not None else ""
        except Exception:
            return DEFAULT_THEME
        return value if value in THEMES else DEFAULT_THEME

    def secure_headers(self) -> None:
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("X-Frame-Options", "DENY")
        self.send_header("Referrer-Policy", "no-referrer")
        self.send_header("Content-Security-Policy", "default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'")

    def require_auth(self) -> bool:
        if auth_ok(self.headers.get("Authorization")):
            return True
        self.send_response(HTTPStatus.UNAUTHORIZED)
        self.send_header("WWW-Authenticate", 'Basic realm="pihm-web"')
        self.secure_headers()
        self.end_headers()
        return False

    def send_html(self, body: str, status: int = 200) -> None:
        data = body.encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.secure_headers()
        self.end_headers()
        self.wfile.write(data)

    def redirect(self, message: str, error: bool = False, target: str = "/") -> None:
        sep = "&" if "?" in target else "?"
        target = target + sep + "message=" + quote(message)
        if error:
            target += "&error=1"
        self.send_response(HTTPStatus.SEE_OTHER)
        self.send_header("Location", target)
        self.secure_headers()
        self.end_headers()

    def do_GET(self) -> None:
        if not self.require_auth():
            return
        parsed = urlparse(self.path)
        q = parse_qs(parsed.query)
        message = q.get("message", [""])[0][:500]
        error = q.get("error", ["0"])[0] == "1"
        theme = self.current_theme()
        if parsed.path in {"/", "/index.html"}:
            open_modal = q.get("open", [""])[0][:120]
            self.send_html(render(message, error, theme, open_modal))
            return
        if parsed.path == "/profile":
            name = q.get("name", [""])[0]
            if not valid_profile(name):
                self.send_error(HTTPStatus.NOT_FOUND)
                return
            self.send_response(HTTPStatus.SEE_OTHER)
            self.send_header("Location", profile_return(name))
            self.secure_headers()
            self.end_headers()
            return
        self.send_error(HTTPStatus.NOT_FOUND)

    def post_data(self) -> dict[str, list[str]]:
        try:
            size = int(self.headers.get("Content-Length", "0"))
        except ValueError:
            size = 0
        if size <= 0 or size > MAX_BODY:
            fail("invalid request size")
        raw = self.rfile.read(size).decode("utf-8", errors="strict")
        return parse_qs(raw, keep_blank_values=True)

    def do_POST(self) -> None:
        if not self.require_auth():
            return

        try:
            data = self.post_data()
            if not hmac.compare_digest(form_one(data, "csrf"), CSRF):
                fail("invalid CSRF token")

            path = urlparse(self.path).path

            if path == "/theme":
                theme = form_one(data, "theme").strip()
                if theme not in THEMES:
                    fail("invalid theme")
                target = safe_return_to(form_one(data, "return_to"))
                self.send_response(HTTPStatus.SEE_OTHER)
                self.send_header("Location", target)
                self.send_header(
                    "Set-Cookie",
                    f"pihm_theme={theme}; Path=/; Max-Age=31536000; SameSite=Strict; HttpOnly",
                )
                self.secure_headers()
                self.end_headers()
                return

            if path == "/maintenance/gravity":
                manager("gravity")
                self.redirect("Blocklists refreshed", target="/?open=maintenance")
                return

            if path == "/maintenance/timer-enable":
                manager("timer", "install")
                self.redirect("Daily blocklist updates enabled", target="/?open=maintenance")
                return

            if path == "/maintenance/timer-disable":
                manager("timer", "remove")
                self.redirect("Daily blocklist updates disabled", target="/?open=maintenance")
                return

            if path == "/maintenance/import-groups":
                imported = import_current_groups()
                if imported:
                    self.redirect("Imported: " + ", ".join(imported), target="/?open=maintenance")
                else:
                    self.redirect("No new Pi-hole groups to import", target="/?open=maintenance")
                return

            if path == "/maintenance/update-pihm":
                installer = pihm_installer_path()
                if installer is None:
                    fail("pihm-installer not found")
                run_checked([str(installer), "update"], timeout=180)
                self.redirect("pihm updated", target="/?open=maintenance")
                return

            if path == "/profile/create":
                name = form_one(data, "name").strip()[:120]
                preset = form_one(data, "preset").strip()
                if not name:
                    fail("profile name is required")
                if preset not in {"", "normal", "strict", "parental"}:
                    fail("invalid profile preset")
                args = ["new", name]
                if preset:
                    args += ["--preset", preset]
                manager(*args)
                self.redirect(f"Profile {name} created", target=profile_return(name))
                return

            if path == "/profile/rename":
                old_name = form_one(data, "profile").strip()
                new_name = form_one(data, "name").strip()[:120]
                if not valid_profile(old_name):
                    fail("profile not found")
                if not new_name:
                    fail("new profile name is required")
                manager("rename", old_name, new_name)
                self.redirect(
                    f"Profile renamed to {new_name}",
                    target=profile_return(new_name),
                )
                return

            if path == "/profile/clone":
                source = form_one(data, "profile").strip()
                name = form_one(data, "name").strip()[:120]
                if not valid_profile(source):
                    fail("profile not found")
                if not name:
                    fail("new profile name is required")
                manager("new", name, "--clone", source)
                self.redirect(f"Profile {name} created", target=profile_return(name))
                return

            if path == "/profile/save":
                profile_name = form_one(data, "profile").strip()
                p = profile_by_name(profile_name)
                write_profile_settings(
                    p,
                    form_one(data, "description"),
                    [value.strip() for value in data.get("keys", []) if value.strip()],
                    clean_lines(form_one(data, "extra_urls")),
                    clean_lines(form_one(data, "allow")),
                    clean_lines(form_one(data, "deny")),
                    clean_lines(form_one(data, "tlds")),
                )
                self.redirect(
                    f"{profile_name} saved; sync when ready",
                    target=profile_return(profile_name),
                )
                return

            if path == "/profile/restore-description":
                profile_name = form_one(data, "profile").strip()
                p = profile_by_name(profile_name)
                live = live_group_description(profile_name)
                if not live:
                    fail("live Pi-hole group has no description to restore")
                write_profile_settings(
                    p,
                    live,
                    p["keys"],
                    p["extra_urls"],
                    p["allow"],
                    p["deny"],
                    p["tlds"],
                )
                self.redirect(
                    f"{profile_name} description restored from Pi-hole",
                    target=profile_return(profile_name),
                )
                return

            if path in {"/profile/link-local-device", "/profile/link-local-device-name"}:
                profile_name = form_one(data, "profile").strip()
                if not valid_profile(profile_name):
                    fail("profile not found")
                device = find_local_tail_device(form_one(data, "device"))
                sync_now = form_one(data, "mode") != "save"
                linked = link_local_tail_device(profile_name, device, sync=sync_now)
                verb = "Linked + synced" if sync_now else "Linked"
                self.redirect(
                    f"{verb} {device['name']}: " + ", ".join(linked),
                    target=profile_return(profile_name),
                )
                return

            if path == "/profile/client-save":
                profile_name = form_one(data, "profile").strip()
                old_address = form_one(data, "old_address").strip()
                new_address = form_one(data, "address").strip()
                label = form_one(data, "label").strip()[:120]
                edit_saved_client(profile_name, old_address, new_address, label)
                self.redirect(
                    f"{profile_name} client saved; sync when ready",
                    target=profile_return(profile_name),
                )
                return

            if path == "/profile/client-delete":
                profile_name = form_one(data, "profile").strip()
                address = form_one(data, "address").strip()
                delete_saved_client(profile_name, address)
                self.redirect(
                    f"{address} removed from saved {profile_name}; sync when ready",
                    target=profile_return(profile_name),
                )
                return

            if path == "/profile/proxy":
                profile_name = form_one(data, "profile").strip()
                p = profile_by_name(profile_name)
                write_proxy_settings(
                    p,
                    form_one(data, "enabled") == "1",
                    form_one(data, "port").strip(),
                    form_one(data, "docker_ip").strip(),
                    form_one(data, "label").strip()[:120],
                )
                self.redirect(
                    f"{profile_name} endpoint settings saved",
                    target=profile_return(profile_name),
                )
                return

            if path == "/sync-gravity":
                profile = form_one(data, "profile").strip()
                if not valid_profile(profile):
                    fail("profile not found")
                manager("apply", profile, "--gravity")
                target = safe_return_to(form_one(data, "return_to")) if form_one(data, "return_to") else profile_return(profile)
                self.redirect(
                    f"{profile} synced and blocklists refreshed",
                    target=target,
                )
                return

            if path == "/tailnet/add":
                label = form_one(data, "label").strip()[:80]
                tailnet = form_one(data, "tailnet").strip()[:200]
                client_id = form_one(data, "client_id").strip()[:300]
                client_secret = form_one(data, "client_secret").strip()[:500]
                if not all((label, tailnet, client_id, client_secret)):
                    fail("all secondary tailnet fields are required")
                rows = [
                    row for row in load_secondary_tailnets()
                    if row["label"].casefold() != label.casefold()
                ]
                entry = {
                    "label": label,
                    "tailnet": tailnet,
                    "client_id": client_id,
                    "client_secret": client_secret,
                }
                devices = secondary_tailnet_devices(entry)
                rows.append(entry)
                save_secondary_tailnets(rows)
                clear_secondary_tailnet_cache()
                SECONDARY_TAILNET_CACHE[
                    "|".join((entry["label"], entry["tailnet"], entry["client_id"]))
                ] = (time.monotonic(), devices)
                self.redirect(f"Secondary tailnet {label} added", target="/?open=tailnets")
                return

            if path == "/tailnet/remove":
                label = form_one(data, "label").strip()
                rows = [row for row in load_secondary_tailnets() if row["label"] != label]
                save_secondary_tailnets(rows)
                clear_secondary_tailnet_cache()
                self.redirect(f"Secondary tailnet {label} removed", target="/?open=tailnets")
                return

            if path == "/assign":
                profile = form_one(data, "profile").strip()
                address = form_one(data, "address").strip()
                label = form_one(data, "label").strip()[:120]
                if not valid_profile(profile):
                    fail("profile not found")
                if not valid_address(address):
                    fail("invalid client address")
                remove_address_from_other_profiles(address, profile)
                args = ["assign", profile, address]
                if label:
                    args += ["--label", label]
                manager(*args)
                self.redirect(f"{address} assigned to {profile}", target="/?open=add-device")
                return

            if path == "/unassign":
                address = form_one(data, "address").strip()
                if not valid_address(address):
                    fail("invalid client address")
                manager("unassign", address)
                self.redirect(f"{address} returned to Default")
                return

            if path == "/default":
                profile = form_one(data, "profile").strip()
                if not valid_profile(profile):
                    fail("profile not found")
                manager("default", profile)
                target = safe_return_to(form_one(data, "return_to")) if form_one(data, "return_to") else "/"
                self.redirect(f"Default fallback set to {profile}", target=target)
                return

            if path == "/sync":
                profile = form_one(data, "profile").strip()
                if not valid_profile(profile):
                    fail("profile not found")
                manager("apply", profile)
                target = safe_return_to(form_one(data, "return_to")) if form_one(data, "return_to") else "/"
                self.redirect(f"{profile} synced to Pi-hole", target=target)
                return

            self.send_error(HTTPStatus.NOT_FOUND)

        except subprocess.CalledProcessError as exc:
            target = "/"
            try:
                current_path = urlparse(self.path).path
                profile_name = form_one(data, "profile") if "data" in locals() else ""
                if profile_name and valid_profile(profile_name):
                    target = profile_return(profile_name)
                elif current_path.startswith("/maintenance/"):
                    target = "/?open=maintenance"
                elif current_path.startswith("/tailnet/"):
                    target = "/?open=tailnets"
                elif current_path in {"/assign", "/profile/link-local-device", "/profile/link-local-device-name"}:
                    target = "/?open=add-device"
            except Exception:
                target = "/"
            self.redirect(f"pihm command failed with status {exc.returncode}", True, target=target)
        except Exception as exc:
            target = "/"
            try:
                current_path = urlparse(self.path).path
                profile_name = form_one(data, "profile") if "data" in locals() else ""
                if profile_name and valid_profile(profile_name):
                    target = profile_return(profile_name)
                elif current_path.startswith("/maintenance/"):
                    target = "/?open=maintenance"
                elif current_path.startswith("/tailnet/"):
                    target = "/?open=tailnets"
                elif current_path in {"/assign", "/profile/link-local-device", "/profile/link-local-device-name"}:
                    target = "/?open=add-device"
            except Exception:
                target = "/"
            self.redirect(str(exc), True, target=target)


def check() -> int:
    problems = []
    if not MANAGER.is_file():
        problems.append(f"missing manager: {MANAGER}")
    if not PROFILES.is_dir():
        problems.append(f"missing profiles directory: {PROFILES}")
    if not FTL_DB.is_file():
        problems.append(f"missing Pi-hole FTL database: {FTL_DB}")
    if not GRAVITY_DB.is_file():
        problems.append(f"missing Pi-hole gravity database: {GRAVITY_DB}")
    if not CATALOG.is_file():
        problems.append(f"missing pihm catalog: {CATALOG}")
    api_url = ""
    if AUTH_SOURCE not in {"pihole", "custom"}:
        problems.append("PIHM_WEB_AUTH_SOURCE must be pihole or custom")
    elif AUTH_SOURCE == "pihole":
        api_url = pihole_api_auth_url()
        if not api_url:
            problems.append(f"Pi-hole API endpoint could not be found for container {PIHOLE_CONTAINER}")
    elif not PASSWORD_OVERRIDE:
        problems.append("PIHM_WEB_PASSWORD is not set for custom auth")
    if not bind_is_loopback() and not ALLOW_REMOTE_BIND:
        problems.append("non-loopback bind requires PIHM_WEB_ALLOW_REMOTE_BIND=1")

    if problems:
        for item in problems:
            print(f"ERROR: {item}")
        return 1

    print("pihm-web check: OK")
    print(f"Manager:  {MANAGER}")
    print(f"Profiles: {PROFILES}")
    print(f"FTL DB:   {FTL_DB}")
    print(f"Gravity:  {GRAVITY_DB}")
    recent = recent_dns_clients()
    current_profiles = profiles()
    counts, _ = profile_activity(current_profiles)
    default_profile = next((p["name"] for p in current_profiles if p["default"]), "")

    print(f"Catalog:  {CATALOG}")
    print(f"Bind:     {BIND}:{PORT}")
    print(f"Auth:     {AUTH_SOURCE}")
    print(f"Recent DNS sources (24h): {len(recent)}")
    if default_profile:
        print(f"Default activity: {default_profile} = {counts.get(default_profile, 0)} recent sources")
    if AUTH_SOURCE == "pihole":
        print(f"Pi-hole API: {api_url}")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="Simple web UI for pihm")
    parser.add_argument("--check", action="store_true", help="validate local prerequisites and exit")
    args = parser.parse_args()

    if args.check:
        return check()

    if AUTH_SOURCE not in {"pihole", "custom"}:
        print("ERROR: PIHM_WEB_AUTH_SOURCE must be pihole or custom", file=sys.stderr)
        return 2

    if AUTH_SOURCE == "pihole" and not pihole_api_auth_url():
        print(f"ERROR: Pi-hole API endpoint could not be found for container {PIHOLE_CONTAINER}", file=sys.stderr)
        return 2

    if AUTH_SOURCE == "custom" and not PASSWORD_OVERRIDE:
        print("ERROR: PIHM_WEB_PASSWORD must be set for custom auth", file=sys.stderr)
        return 2

    if not MANAGER.is_file():
        print(f"ERROR: pihole-profile-manager not found: {MANAGER}", file=sys.stderr)
        return 2

    if not bind_is_loopback() and not ALLOW_REMOTE_BIND:
        print("ERROR: refusing non-loopback bind without PIHM_WEB_ALLOW_REMOTE_BIND=1", file=sys.stderr)
        return 2

    server = ThreadingHTTPServer((BIND, PORT), Handler)
    print(f"pihm-web listening on http://{BIND}:{PORT}", flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
