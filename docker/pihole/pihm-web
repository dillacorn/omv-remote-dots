def detected_proxy_addresses() -> tuple[str, str, str]:
    hostname = ""
    tail_ip = ""
    lan_ip = ""

    raw = run(["tailscale", "status", "--json"])
    if raw:
        try:
            hostname = str(json.loads(raw).get("Self", {}).get("DNSName") or "").rstrip(".")
        except Exception:
            pass

    values = run(["tailscale", "ip", "-4"]).splitlines()
    if values:
        tail_ip = values[0].strip()

    raw = run(["docker", "inspect", PIHOLE_CONTAINER])
    if raw:
        try:
            info = json.loads(raw)[0]
            ports = info.get("NetworkSettings", {}).get("Ports", {})
            for key in ("53/tcp", "53/udp"):
                for binding in ports.get(key) or []:
                    value = str(binding.get("HostIp") or "").strip()
                    if value and value not in {"0.0.0.0", "::", "127.0.0.1"} and not value.startswith("100."):
                        lan_ip = value
                        break
                if lan_ip:
                    break
        except Exception:
            pass

    return (
        hostname or "OMV Tailscale hostname",
        lan_ip or "OMV LAN IPv4",
        tail_ip or "OMV Tailscale IPv4",
    )


