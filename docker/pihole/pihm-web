def next_proxy_slot(profile_name: str) -> tuple[int, str]:
    used_ports = set()
    used_ips = set()
    for p in profiles():
        if p["name"] == profile_name or not p["proxy_enabled"]:
            continue
        if str(p["proxy_port"]).isdigit():
            used_ports.add(int(p["proxy_port"]))
        if p["proxy_ip"]:
            used_ips.add(p["proxy_ip"])
    port = 18101
    while port in used_ports:
        port += 1
    octet = 101
    while f"172.30.53.{octet}" in used_ips:
        octet += 1
    if octet > 254:
        fail("no free proxy Docker IP remains in 172.30.53.0/24")
    return port, f"172.30.53.{octet}"


def auto_lan_for_tail_device(device: dict, candidates: list[dict]) -> tuple[str, str]:
    direct = [
        value
        for value in device.get("lan_candidates", [])
        if rfc1918_ipv4(value)
    ]
    if direct:
        return direct[0], "Tailscale direct connection"

    names = {
        normalize_device_name(device.get("name", "")),
        normalize_device_name(device.get("dns", "")),
    }
    names.discard("")
    matches = []
    for item in candidates:
        name = normalize_device_name(item.get("name", ""))
        if name and name in names:
            matches.append(item["ip"])
    if len(matches) == 1:
        return matches[0], "matching LAN hostname"
    return "", ""


def find_local_tail_device(value: str) -> dict:
    needle = value.strip().rstrip(".").casefold()
    short = needle.split(".", 1)[0]
    matches = []
    for device in tailscale_devices():
        values = {
            str(device.get("name") or "").casefold(),
            str(device.get("dns") or "").casefold(),
            str(device.get("dns") or "").split(".", 1)[0].casefold(),
            str(device.get("ip") or "").casefold(),
        }
        if needle in values or short in values:
            matches.append(device)
    if len(matches) != 1:
        fail("Tailscale device not found or ambiguous")
    return matches[0]


def link_local_tail_device(profile_name: str, device: dict) -> list[str]:
    p = profile_by_name(profile_name)
    candidates = recent_lan_clients()
    lan_ip, _ = auto_lan_for_tail_device(device, candidates)
    entries = [(device["ip"], f"{device['name']} - Tailscale")]
    if lan_ip:
        entries.append((lan_ip, f"{device['name']} - LAN"))

    current = list(p["clients"])
    for address, label in entries:
        remove_address_from_other_profiles(address, profile_name)
        current = [(a, old_label) for a, old_label in current if a != address]
        current.append((address, label))
    write_profile_clients(p, current)
    manager("apply", profile_name)
    return [address for address, _ in entries]


def write_profile_clients(profile: dict, entries: list[tuple[str, str]]) -> None:
    cfg = configparser.ConfigParser(interpolation=None)
    cfg.optionxform = str
    with profile["path"].open(encoding="utf-8") as fh:
        cfg.read_file(fh)
    if not cfg.has_section("clients"):
        cfg.add_section("clients")
    cfg.set(
        "clients",
        "entries",
        "\n" + "\n".join(
            f"{address} | {label}" if label else address
            for address, label in entries
        ),
    )
    import io
    buf = io.StringIO()
    cfg.write(buf)
    profile["path"].write_text(buf.getvalue(), encoding="utf-8")


def edit_saved_client(
    profile_name: str,
    old_address: str,
    new_address: str,
    label: str,
) -> None:
    if not valid_address(new_address):
        fail("invalid client address")
    p = profile_by_name(profile_name)
    found = False
    entries = []
    for address, old_label in p["clients"]:
        if address == old_address and not found:
            entries.append((new_address, label))
            found = True
        else:
            entries.append((address, old_label))
    if not found:
        fail("client address is no longer in this profile")

    for other in profiles():
        for address, _ in other["clients"]:
            if address != new_address:
                continue
            if other["name"] != profile_name or address != old_address:
                fail(f"{new_address} is already saved in profile {other['name']}")

    write_profile_clients(p, entries)


def delete_saved_client(profile_name: str, address: str) -> None:
    p = profile_by_name(profile_name)
    entries = [(a, label) for a, label in p["clients"] if a != address]
    if len(entries) == len(p["clients"]):
        fail("client address is no longer in this profile")
    write_profile_clients(p, entries)


