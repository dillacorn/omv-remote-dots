        )

    assigned_rows = []
    for item in sorted(assigned, key=lambda x: (x["profile"].casefold(), x["address"])):
        remove = action_form("/unassign", {"address": item["address"]}, "Remove")
        assigned_rows.append(
            f"""<tr>
              <td>{h(item["label"] or "—")}</td>
              <td><code>{h(item["address"])}</code></td>
              <td><code>{h(item["mac"] or "—")}</code></td>
              <td>{h(item["profile"])}</td>
              <td>{remove}</td>
            </tr>"""
        )

    lan_rows = []
    for item in recent_lan_clients():
        if item["ip"] in assigned_addresses:
            continue
        assign = action_form(
            "/assign",
            {
                "address": item["ip"],
