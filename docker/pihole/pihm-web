                "label": item["name"] or f"LAN device {item['ip']}",
            },
            "Assign",
            select_profile=True,
        )
        reserve = (
            f'Reserve <code>{h(item["ip"])}</code> for <code>{h(item["mac"])}</code> on the router.'
