def auth_ok(header: str | None) -> bool:
    if not header or not header.startswith("Basic "):
        return False
    try:
        decoded = base64.b64decode(header[6:], validate=True).decode("utf-8")
        user, sep, password = decoded.partition(":")
        if not sep:
            return False
    except Exception:
        return False

    if not hmac.compare_digest(user, USERNAME):
        return False

    if AUTH_SOURCE == "pihole":
        return pihole_password_valid(password)

    if AUTH_SOURCE == "custom":
        return hmac.compare_digest(
            hashlib.sha256(password.encode()).digest(),
            hashlib.sha256(PASSWORD_OVERRIDE.encode()).digest(),
        )

    return False


