def bind_is_loopback() -> bool:
    if BIND.casefold() == "localhost":
        return True
    try:
        return ipaddress.ip_address(BIND).is_loopback
    except ValueError:
        return False


def h(value) -> str:
    return html.escape(str(value), quote=True)


def auth_ok(header: str | None) -> bool:
    if not header or not header.startswith("Basic "):
        return False
    try:
        decoded = base64.b64decode(header[6:], validate=True).decode("utf-8")
        user, sep, password = decoded.partition(":")
        if not sep:
            return False
    except Exception:
        return False

    if not hmac.compare_digest(user, USERNAME):
        return False

    if AUTH_SOURCE == "pihole":
        return pihole_password_valid(password)

    if AUTH_SOURCE == "custom":
        return hmac.compare_digest(
            hashlib.sha256(password.encode()).digest(),
            hashlib.sha256(PASSWORD_OVERRIDE.encode()).digest(),
        )

    return False


def profile_options(current: str = "") -> str:
    rows = []
    for p in profiles():
        selected = " selected" if p["name"] == current else ""
        marker = " [DEFAULT]" if p["default"] else ""
        rows.append(f'<option value="{h(p["name"])}"{selected}>{h(p["name"] + marker)}</option>')
    return "".join(rows)


def action_form(action: str, fields: dict[str, str], label: str, select_profile: bool = False) -> str:
    hidden = [
        f'<input type="hidden" name="csrf" value="{h(CSRF)}">',
    ]
    for key, value in fields.items():
        hidden.append(f'<input type="hidden" name="{h(key)}" value="{h(value)}">')
    select = (
        f'<select name="profile">{profile_options()}</select>'
        if select_profile
        else ""
    )
    return (
        f'<form method="post" action="{h(action)}" class="inline">'
        + "".join(hidden)
        + select
        + f'<button type="submit">{h(label)}</button></form>'
    )


def render(message: str = "", error: bool = False) -> str:
    ps = profiles()
    macs = neighbor_map()
    assigned = []
    assigned_addresses = set()
    activity_counts, dns_activity = profile_activity(ps)
    tail_devices, tailnet_states = all_tailscale_devices()

    for p in ps:
        for address, label in p["clients"]:
            assigned_addresses.add(address)
            assigned.append({
                "address": address,
                "label": label,
                "profile": p["name"],
                "mac": macs.get(address, ""),
            })

    profile_cards = []
    for p in ps:
        default = '<span class="tag">DEFAULT</span>' if p["default"] else ""
        set_default = "" if p["default"] else action_form(
            "/default", {"profile": p["name"]}, "Make default"
        )
        sync = action_form("/sync", {"profile": p["name"]}, "Sync")
        edit = f'<a class="button" href="/profile?name={quote(p["name"])}">Edit</a>'
        profile_cards.append(
            f"""<div class="card">
