HOME = Path(os.environ.get("PIHM_HOME", "/docker/pihole"))
MANAGER = Path(os.environ.get("PIHOLE_PROFILE_MANAGER", str(HOME / "pihole-profile-manager")))
PROFILES = Path(os.environ.get("PIHOLE_PROFILES_DIR", str(HOME / "profiles.d")))
FTL_DB = Path(os.environ.get("PIHOLE_FTL_DB", str(HOME / "etc-pihole/pihole-FTL.db")))

BIND = os.environ.get("PIHM_WEB_BIND", "127.0.0.1")
PORT = int(os.environ.get("PIHM_WEB_PORT", "8091"))
USERNAME = os.environ.get("PIHM_WEB_USERNAME", "admin")
PASSWORD = os.environ.get("PIHM_WEB_PASSWORD", "")
ALLOW_REMOTE_BIND = os.environ.get("PIHM_WEB_ALLOW_REMOTE_BIND", "").strip().lower() in {"1", "true", "yes"}
CSRF = secrets.token_urlsafe(32)
MAX_BODY = 16 * 1024


def fail(message: str) -> None:
    raise RuntimeError(message)


def run(argv: list[str], timeout: int = 10) -> str:
    try:
        return subprocess.check_output(
            argv,
            text=True,
            stderr=subprocess.DEVNULL,
            timeout=timeout,
        ).strip()
    except Exception:
        return ""


def run_checked(argv: list[str], timeout: int = 45) -> None:
    subprocess.run(argv, check=True, timeout=timeout)


def load_profile(path: Path) -> dict:
    cfg = configparser.ConfigParser(interpolation=None)
    cfg.optionxform = str
    with path.open(encoding="utf-8") as fh:
        cfg.read_file(fh)

    name = cfg.get("profile", "name", fallback=path.stem).strip() or path.stem
    is_default = cfg.getboolean("profile", "default", fallback=False)
    clients = []
    for raw in cfg.get("clients", "entries", fallback="").splitlines():
        raw = raw.strip()
        if not raw or raw.startswith(("#", ";")):
            continue
        address, sep, label = raw.partition("|")
        clients.append((address.strip(), label.strip() if sep else ""))

    keys = [
        x.strip()
        for x in cfg.get("lists", "keys", fallback="").splitlines()
        if x.strip() and not x.lstrip().startswith(("#", ";"))
    ]

    return {
        "path": path,
        "name": name,
        "default": is_default,
        "clients": clients,
        "lists": len(keys),
    }


def profiles() -> list[dict]:
    PROFILES.mkdir(parents=True, exist_ok=True)
    out = []
    for path in sorted(PROFILES.glob("*.ini")):
        try:
            out.append(load_profile(path))
        except Exception:
            continue
    return out


def rfc1918_ipv4(value: str) -> bool:
    try:
        ip = ipaddress.ip_address(value)
    except ValueError:
        return False
    if ip.version != 4:
        return False
    return (
        ip in ipaddress.ip_network("10.0.0.0/8")
        or ip in ipaddress.ip_network("172.16.0.0/12")
        or ip in ipaddress.ip_network("192.168.0.0/16")
    )


def direct_lan_networks() -> list[ipaddress.IPv4Network]:
    networks = []
    raw = run(["ip", "-4", "route", "show", "scope", "link"])
    for line in raw.splitlines():
        parts = line.split()
        if not parts:
            continue
        dev = ""
        if "dev" in parts:
            try:
                dev = parts[parts.index("dev") + 1]
            except (ValueError, IndexError):
                dev = ""
        if dev in {"lo", "tailscale0"} or dev.startswith(("docker", "br-", "veth")):
            continue
        try:
            net = ipaddress.ip_network(parts[0], strict=False)
        except ValueError:
            continue
        if isinstance(net, ipaddress.IPv4Network) and rfc1918_ipv4(str(net.network_address)):
            networks.append(net)
    return networks


def is_direct_lan_ip(value: str, networks: list[ipaddress.IPv4Network] | None = None) -> bool:
    if not rfc1918_ipv4(value):
        return False
    nets = direct_lan_networks() if networks is None else networks
    if not nets:
        return True
    ip = ipaddress.ip_address(value)
    return any(ip in net for net in nets)


def neighbor_map() -> dict[str, str]:
    out: dict[str, str] = {}
    for line in run(["ip", "neigh", "show"]).splitlines():
        parts = line.split()
        if not parts:
            continue
        try:
            ipaddress.ip_address(parts[0])
        except ValueError:
            continue
        if "lladdr" not in parts:
            continue
        try:
            out[parts[0]] = parts[parts.index("lladdr") + 1].lower()
        except (ValueError, IndexError):
            pass
    return out


def recent_lan_clients() -> list[dict]:
    found: dict[str, dict] = {}
    macs = neighbor_map()
    local_networks = direct_lan_networks()

    if FTL_DB.is_file():
        try:
            db = sqlite3.connect(f"file:{FTL_DB}?mode=ro", uri=True)
            db.row_factory = sqlite3.Row
            tables = {r[0] for r in db.execute("SELECT name FROM sqlite_master WHERE type='table'")}
            if "network_addresses" in tables:
                cols = {r[1] for r in db.execute("PRAGMA table_info(network_addresses)")}
                if "ip" in cols:
                    name_expr = "name" if "name" in cols else "''"
                    seen_expr = "lastSeen" if "lastSeen" in cols else "0"
                    query = f"SELECT ip,{name_expr} AS name,{seen_expr} AS lastSeen FROM network_addresses"
                    for row in db.execute(query):
                        value = str(row["ip"] or "")
                        try:
                            ip = ipaddress.ip_address(value)
                        except ValueError:
                            continue
                        if ip.version != 4 or not is_direct_lan_ip(value, local_networks):
                            continue
                        found[value] = {
                            "ip": value,
                            "name": str(row["name"] or ""),
                            "last_seen": int(row["lastSeen"] or 0),
                            "mac": macs.get(value, ""),
                        }
            db.close()
        except Exception:
            pass

    for value, mac in macs.items():
        try:
            ip = ipaddress.ip_address(value)
        except ValueError:
            continue
        if ip.version != 4 or not is_direct_lan_ip(value, local_networks):
            continue
        found.setdefault(
            value,
            {"ip": value, "name": "", "last_seen": 0, "mac": mac},
        )
        if mac:
            found[value]["mac"] = mac

    def sort_key(item: dict):
        parts = tuple(int(x) for x in item["ip"].split("."))
        return (-int(item["last_seen"] or 0), parts)

    return sorted(found.values(), key=sort_key)


def tailscale_devices() -> list[dict]:
    raw = run(["tailscale", "status", "--json"])
    if not raw:
        return []
    try:
        data = json.loads(raw)
    except Exception:
        return []

    peers = data.get("Peer", {})
    nodes = list(peers.values()) if isinstance(peers, dict) else list(peers or [])
    out = []

    for node in nodes:
        ipv4 = ""
        for value in node.get("TailscaleIPs") or []:
            try:
                ip = ipaddress.ip_address(value)
            except ValueError:
                continue
            if ip.version == 4:
                ipv4 = str(ip)
                break
        if not ipv4:
            continue

        dns = str(node.get("DNSName") or "").rstrip(".")
        host = str(node.get("HostName") or "").strip()
        name = host or (dns.split(".", 1)[0] if dns else ipv4)

        out.append({
            "name": name,
            "dns": dns,
            "ip": ipv4,
            "online": bool(node.get("Online", False)),
        })

    return sorted(out, key=lambda d: (not d["online"], d["name"].casefold()))


def age_text(value: int) -> str:
    if not value:
        return "seen on LAN"
    age = max(0, int(time.time()) - int(value))
    if age < 60:
        return "just now"
    if age < 3600:
        return f"{age // 60}m ago"
    if age < 86400:
        return f"{age // 3600}h ago"
    return f"{age // 86400}d ago"


def upstream_text() -> str:
    raw = run(["docker", "inspect", "dnsproxy", "--format", "{{json .Config.Cmd}}"])
    if not raw:
        raw = run(["docker", "inspect", "dnsproxy-quad9", "--format", "{{json .Config.Cmd}}"])
    if "dns.quad9.net" in raw:
        return "Quad9 DoH"
    if "dns.nextdns.io" in raw:
        return "NextDNS DoH"
    return "Custom / unavailable"


def manager(*args: str) -> None:
    if not MANAGER.is_file():
        fail(f"pihole-profile-manager not found: {MANAGER}")
    run_checked([str(MANAGER), *args])


def valid_profile(name: str) -> bool:
    return any(p["name"] == name for p in profiles())


def valid_address(value: str) -> bool:
    try:
        ipaddress.ip_address(value)
        return True
    except ValueError:
        return False


def bind_is_loopback() -> bool:
    if BIND.casefold() == "localhost":
        return True
    try:
        return ipaddress.ip_address(BIND).is_loopback
    except ValueError:
        return False


def h(value) -> str:
    return html.escape(str(value), quote=True)


def auth_ok(header: str | None) -> bool:
    if not header or not header.startswith("Basic "):
        return False
    try:
        decoded = base64.b64decode(header[6:], validate=True).decode("utf-8")
        user, sep, password = decoded.partition(":")
        if not sep:
            return False
    except Exception:
        return False

    return (
        hmac.compare_digest(user, USERNAME)
        and hmac.compare_digest(
            hashlib.sha256(password.encode()).digest(),
            hashlib.sha256(PASSWORD.encode()).digest(),
        )
    )


def profile_options(current: str = "") -> str:
    rows = []
    for p in profiles():
        selected = " selected" if p["name"] == current else ""
        marker = " [DEFAULT]" if p["default"] else ""
        rows.append(f'<option value="{h(p["name"])}"{selected}>{h(p["name"] + marker)}</option>')
    return "".join(rows)


def action_form(action: str, fields: dict[str, str], label: str, select_profile: bool = False) -> str:
    hidden = [
        f'<input type="hidden" name="csrf" value="{h(CSRF)}">',
    ]
    for key, value in fields.items():
        hidden.append(f'<input type="hidden" name="{h(key)}" value="{h(value)}">')
    select = (
        f'<select name="profile">{profile_options()}</select>'
        if select_profile
        else ""
    )
    return (
        f'<form method="post" action="{h(action)}" class="inline">'
        + "".join(hidden)
        + select
        + f'<button type="submit">{h(label)}</button></form>'
    )


