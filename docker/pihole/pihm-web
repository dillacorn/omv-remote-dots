def safe_return_to(value: str) -> str:
    value = value.strip()
    if not value.startswith("/") or value.startswith("//"):
        return "/"
    parsed = urlparse(value)
    if parsed.scheme or parsed.netloc or parsed.path not in {"/", "/profile"}:
        return "/"
    return value


