def remove_address_from_other_profiles(address: str, target_name: str) -> None:
    for p in profiles():
        if p["name"] == target_name:
            continue
        kept = [(a, label) for a, label in p["clients"] if a != address]
        if len(kept) == len(p["clients"]):
            continue
        cfg = configparser.ConfigParser(interpolation=None)
        cfg.optionxform = str
        with p["path"].open(encoding="utf-8") as fh:
            cfg.read_file(fh)
        if not cfg.has_section("clients"):
            cfg.add_section("clients")
        cfg.set(
            "clients",
            "entries",
            "\n" + "\n".join(f"{a} | {label}" if label else a for a, label in kept),
        )
        import io
        buf = io.StringIO()
        cfg.write(buf)
        p["path"].write_text(buf.getvalue(), encoding="utf-8")


