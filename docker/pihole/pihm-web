th,td { text-align:left; padding:7px 8px; border-bottom:1px solid var(--line); vertical-align:middle; }
th { color:var(--muted); font-weight:600; background:var(--panel); position:sticky; top:0; z-index:1; }
tr:last-child td { border-bottom:0; }
.compact-list { border:1px solid var(--line); }
.compact-row { display:grid; grid-template-columns:minmax(140px,1.1fr) minmax(180px,1.6fr) auto; gap:8px; align-items:center; padding:7px 8px; border-bottom:1px solid var(--line); }
.compact-row:last-child { border-bottom:0; }
.empty { border:1px dashed var(--line); color:var(--muted); padding:10px; }
.split { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; }
.field { margin-top:10px; }
.field label { display:block; font-weight:600; margin-bottom:4px; }
.check-list { border:1px solid var(--line); max-height:230px; overflow:auto; }
.check { display:block; padding:6px 8px; border-bottom:1px solid var(--line); }
.check:last-child { border-bottom:0; }
.modal {
  position:fixed; inset:0; z-index:50; display:flex; align-items:center; justify-content:center;
  padding:18px; background:rgba(0,0,0,.66); opacity:0; pointer-events:none;
  transition:opacity .14s ease;
}
.modal.open { opacity:1; pointer-events:auto; }
.modal-panel {
  width:min(980px,96vw); max-height:90vh; overflow:auto; background:var(--bg);
  border:1px solid var(--accent); box-shadow:0 20px 70px rgba(0,0,0,.55);
  transform:translateY(8px); transition:transform .14s ease;
}
.modal.open .modal-panel { transform:translateY(0); }
.modal-panel.wide { width:min(1160px,97vw); }
.modal-head {
  position:sticky; top:0; z-index:5; display:flex; justify-content:space-between; align-items:center;
  gap:10px; padding:10px 12px; background:var(--panel); border-bottom:1px solid var(--line);
}
.modal-body { padding:12px; }
.modal-close { width:36px; min-width:36px; padding:5px; font-size:18px; }
.modal-actions { display:flex; flex-wrap:wrap; gap:5px; margin:8px 0 12px; }
.filter { width:100%; max-width:360px; }
details { border:1px solid var(--line); padding:8px; margin-top:10px; }
summary { cursor:pointer; font-weight:600; }
.walkthrough { border-left:3px solid var(--accent); padding:8px 10px; margin:10px 0; background:var(--panel); }
.walkthrough ol { margin:7px 0 0 20px; padding:0; }
.walkthrough li { margin:4px 0; }
@media (max-width:720px) {
  main { padding:10px; }
  .topbar { flex-direction:column; }
  .top-meta { text-align:left; }
  .profile-grid,.split { grid-template-columns:1fr; }
  .compact-row { grid-template-columns:1fr; }
  .modal { padding:6px; }
  .modal-panel,.modal-panel.wide { width:100%; max-height:96vh; }
}
