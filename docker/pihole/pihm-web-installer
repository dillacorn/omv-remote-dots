#!/usr/bin/env bash
# Optional pihm-web installer.
#
# pihm-web stays separate from the pihm TUI. It installs a localhost-only
# systemd service by default and does not alter Pi-hole, nginx, firewall,
# Tailscale Serve, or router settings automatically.

set -euo pipefail

REPO="${PIHM_WEB_REPO:-dillacorn/omv-remote-dots}"
REF="${PIHM_WEB_REF:-main}"
HOME="${PIHM_HOME:-/docker/pihole}"
BINDIR="${PIHM_WEB_BINDIR:-/usr/local/bin}"
ENV_FILE="${PIHM_WEB_ENV_FILE:-/etc/pihm-web.env}"
SERVICE_FILE="/etc/systemd/system/pihm-web.service"
ACTION="${1:-install}"
RAW_BASE="https://raw.githubusercontent.com/${REPO}/${REF}/docker/pihole"

die() {
    printf 'ERROR: %s\n' "$*" >&2
    exit 1
}

need() {
    command -v "$1" >/dev/null 2>&1 || die "Required command not found: $1"
}

[[ ${EUID:-$(id -u)} -eq 0 ]] || die "Run as root (or with sudo)."

case "$ACTION" in
    install|update|uninstall|status) ;;
    *) die "Usage: pihm-web-installer [install|update|uninstall|status]" ;;
esac

if [[ "$ACTION" == "status" ]]; then
    systemctl status pihm-web.service --no-pager
    exit $?
fi

if [[ "$ACTION" == "uninstall" ]]; then
    systemctl disable --now pihm-web.service >/dev/null 2>&1 || true
    rm -f "$SERVICE_FILE" "$BINDIR/pihm-web" "$BINDIR/pihm-web-installer"
    rm -f "$HOME/pihm-web" "$HOME/pihm-web-installer"
    systemctl daemon-reload
    printf 'Removed pihm-web program/service files.\n'
    printf 'Preserved %s and /var/lib/pihm-web so settings are not silently destroyed.\n' "$ENV_FILE"
    exit 0
fi

need curl
need install
need python3
need systemctl

[[ -x "$HOME/pihole-profile-manager" ]] || die "Install pihm first; missing $HOME/pihole-profile-manager"

mkdir -p "$HOME" "$BINDIR"

stage="$(mktemp -d)"
trap 'rm -rf -- "$stage"' EXIT

curl -fsSL "$RAW_BASE/pihm-web" -o "$stage/pihm-web"
curl -fsSL "$RAW_BASE/pihm-web-installer" -o "$stage/pihm-web-installer"

python3 -m py_compile "$stage/pihm-web"
bash -n "$stage/pihm-web-installer"

stamp="$(date '+%Y%m%d-%H%M%S')"
for target in pihm-web pihm-web-installer; do
    if [[ -e "$HOME/$target" ]] && ! cmp -s "$stage/$target" "$HOME/$target"; then
        cp -a -- "$HOME/$target" "$HOME/${target}.backup-${stamp}"
        printf 'Backup: %s\n' "$HOME/${target}.backup-${stamp}"
    fi
done
if [[ -e "$SERVICE_FILE" ]]; then
    cp -a -- "$SERVICE_FILE" "${SERVICE_FILE}.backup-${stamp}"
fi

if [[ ! -f "$ENV_FILE" ]]; then
    umask 077
    cat >"$ENV_FILE" <<EOF
PIHM_WEB_BIND=127.0.0.1
PIHM_WEB_PORT=8091
PIHM_WEB_USERNAME=admin
PIHM_WEB_AUTH_SOURCE=pihole
EOF
    chmod 0600 "$ENV_FILE"
    printf 'Created %s\n' "$ENV_FILE"
else
    if grep -q '^PIHM_WEB_PASSWORD=' "$ENV_FILE"; then
        backup="$ENV_FILE.backup-$(date '+%Y%m%d-%H%M%S')"
        cp -a "$ENV_FILE" "$backup"
        tmp="$(mktemp)"
        sed '/^PIHM_WEB_PASSWORD=/d' "$ENV_FILE" >"$tmp"
        if grep -q '^PIHM_WEB_AUTH_SOURCE=' "$tmp"; then
            sed -i 's/^PIHM_WEB_AUTH_SOURCE=.*/PIHM_WEB_AUTH_SOURCE=pihole/' "$tmp"
        else
            printf '\nPIHM_WEB_AUTH_SOURCE=pihole\n' >>"$tmp"
        fi
        install -m 0600 "$tmp" "$ENV_FILE"
        rm -f "$tmp"
        printf 'Removed the old separate pihm-web password. Backup: %s\n' "$backup"
    elif ! grep -q '^PIHM_WEB_AUTH_SOURCE=' "$ENV_FILE"; then
        printf '\nPIHM_WEB_AUTH_SOURCE=pihole\n' >>"$ENV_FILE"
        chmod 0600 "$ENV_FILE"
    fi
fi

install -m 0755 "$stage/pihm-web" "$HOME/pihm-web"
install -m 0755 "$stage/pihm-web-installer" "$HOME/pihm-web-installer"
ln -sfn "$HOME/pihm-web" "$BINDIR/pihm-web"
ln -sfn "$HOME/pihm-web-installer" "$BINDIR/pihm-web-installer"

cat >"$SERVICE_FILE" <<EOF
[Unit]
Description=pihm web interface
After=docker.service tailscaled.service
Wants=docker.service

[Service]
Type=simple
EnvironmentFile=$ENV_FILE
ExecStart=$HOME/pihm-web
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
StateDirectory=pihm-web
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload

set -a
. "$ENV_FILE"
set +a
"$HOME/pihm-web" --check

systemctl enable pihm-web.service >/dev/null
systemctl restart pihm-web.service

printf '\npihm-web installed.\n'
printf 'Local backend: http://127.0.0.1:8091\n'
printf 'Status: pihm-web-installer status\n'
printf 'Login username: admin\n'
printf 'Login password: use the existing Pi-hole web password\n'
printf '\nThe service is localhost-only by default.\n'
printf 'Use SSH port forwarding or Tailscale Serve for remote browser access.\n'
