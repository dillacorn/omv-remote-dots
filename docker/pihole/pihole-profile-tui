def clear(): print("\033[2J\033[H",end="",flush=True)
def width(): return max(60,shutil.get_terminal_size((100,30)).columns)
def clip(s,n): return s if len(s)<=n else s[:max(0,n-1)]+"…"


def key():
    fd=sys.stdin.fileno(); old=termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        data=os.read(fd,1)
        if data==b"\x1b" and select.select([fd],[],[],0.035)[0]:
            second=os.read(fd,1)
            data+=second
            if second==b"[":
                while len(data)<8 and select.select([fd],[],[],0.035)[0]:
                    ch=os.read(fd,1)
                    data+=ch
                    # Stop at the end of this CSI sequence so a held arrow
                    # key can deliver the next repeated sequence separately.
                    if ch==b"~" or (b"A" <= ch <= b"Z") or (b"a" <= ch <= b"z"):
                        break
    finally:
        termios.tcsetattr(fd,termios.TCSADRAIN,old)
    m={b"\x1b[A":"UP",b"\x1b[B":"DOWN",b"\x1b[5~":"PGUP",b"\x1b[6~":"PGDN",b"\x1b[H":"HOME",b"\x1b[F":"END",b"\r":"ENTER",b"\n":"ENTER",b"\x1b":"ESC"}
    return m.get(data,data.decode(errors="ignore"))


def heading(name,sub=""):
    clear(); print(f"{BOLD}{CYAN}{name}{RESET}")
    if sub: print(clip(sub,width()))
    print("─"*min(width(),100))


def menu(name,items,sub="",default=0,footer="Up/Down or j/k = move   Enter = select   h = help   q/Esc = back"):
    if not items: items=["(empty)"]
    i=max(0,min(default,len(items)-1)); off=0
    while True:
        rows=max(5,shutil.get_terminal_size((100,30)).lines-8)
        if i<off: off=i
        if i>=off+rows: off=i-rows+1
        heading(name,sub)
        for n in range(off,min(len(items),off+rows)):
            line=f" {'>' if n==i else ' '} {n+1:>2}. {items[n]}"
            print((REV if n==i else "")+clip(line,width())+(RESET if n==i else ""))
        if len(items)>rows: print(DIM+f"\nShowing {off+1}-{min(len(items),off+rows)} of {len(items)}"+RESET)
        print("\n"+DIM+footer+RESET)
        k=key(); lo=k.lower() if len(k)==1 else k
        if k=="UP" or lo=="k": i=(i-1)%len(items)
        elif k=="DOWN" or lo=="j": i=(i+1)%len(items)
        elif k=="PGUP": i=max(0,i-rows)
        elif k=="PGDN": i=min(len(items)-1,i+rows)
        elif k=="HOME": i=0
        elif k=="END": i=len(items)-1
        elif k=="ENTER": return i
        elif lo=="h" and name!="Help" and "help_screen" in globals():
            help_screen()
        elif k=="ESC" or lo in {"q","b"}: return None
        elif lo.isdigit() and lo!="0" and int(lo)<=len(items): return int(lo)-1


def pause(msg="Press any key to continue..."):
    print("\n"+DIM+msg+RESET,end="",flush=True); key(); print()


def prompt(label,default=""):
    clear(); print(f"{BOLD}{label}{RESET}")
    if default: print(DIM+f"Current: {default}"+RESET)
    print(DIM+"Blank keeps current. Type /cancel to cancel."+RESET)
    try: v=input("> ").strip()
    except (EOFError,KeyboardInterrupt): return None
    if v=="/cancel": return None
    return default if not v else v


def confirm(text):
    clear()
    try: return input(f"{text} [y/N]: ").strip().lower() in {"y","yes"}
    except (EOFError,KeyboardInterrupt): return False


def external(label,fn):
    clear(); print(f"{BOLD}{label}{RESET}\n")
    try: fn(); print(f"\n{GREEN}Done.{RESET}")
    except BaseException as e: print(f"\n{RED}ERROR:{RESET} {e}")
    pause()


def cfg(path): return M["cfg"](path)
def dump(c,path): path.write_text(M["_dump"](c),encoding="utf-8")


def lines(path,section,opt):
    c=cfg(path); return M["lines"](c.get(section,opt,fallback=""))


def set_lines(path,section,opt,values):
    c=cfg(path)
    if not c.has_section(section): c.add_section(section)
    c.set(section,opt,"\n"+"\n".join(values)); dump(c,path)


def set_value(path,section,opt,value):
    c=cfg(path)
    if not c.has_section(section): c.add_section(section)
    c.set(section,opt,value); dump(c,path)


def show_text(name,text,sub=""):
    data=text.splitlines() or [""]; off=0
    while True:
        rows=max(5,shutil.get_terminal_size((100,30)).lines-7); heading(name,sub)
        for line in data[off:off+rows]: print(clip(line,width()))
        print("\n"+DIM+"Up/Down/PgUp/PgDn = scroll   q/Esc = back"+RESET)
        k=key(); lo=k.lower() if len(k)==1 else k
        if k=="UP" or lo=="k": off=max(0,off-1)
        elif k=="DOWN" or lo=="j": off=min(max(0,len(data)-rows),off+1)
        elif k=="PGUP": off=max(0,off-rows)
        elif k=="PGDN": off=min(max(0,len(data)-rows),off+rows)
        elif k=="ESC" or lo in {"q","b"}: return


def edit_values(path,section,opt,name):
    pos=0
    while True:
        vals=lines(path,section,opt); items=vals+["+ Add item","Back"]
        c=menu(name,items,str(path.name),min(pos,len(items)-1))
        if c is None or c==len(items)-1: return
        pos=c
        if c==len(vals):
            v=prompt(f"Add to {name}")
            if v and v not in vals: vals.append(v); set_lines(path,section,opt,vals)
            continue
        action=menu(name,["Edit","Delete","Back"],vals[c])
        if action==0:
            v=prompt(f"Edit {name}",vals[c])
            if v is not None: vals[c]=v; set_lines(path,section,opt,vals)
        elif action==1 and confirm(f"Delete {vals[c]}?"):
            vals.pop(c); set_lines(path,section,opt,vals); pos=max(0,c-1)


def _rfc1918_ipv4(value):
    try:
        ip=ipaddress.ip_address(value)
    except ValueError:
        return False
    if ip.version!=4:
        return False
    return (
        ip in ipaddress.ip_network("10.0.0.0/8")
        or ip in ipaddress.ip_network("172.16.0.0/12")
        or ip in ipaddress.ip_network("192.168.0.0/16")
    )


def _norm_device_name(value):
    value=(value or "").strip().rstrip(".").split(".",1)[0].casefold()
    # Tailscale may add a collision suffix such as "-1". Remove only that
    # suffix; keep meaningful model/name digits such as "s24".
    value=re.sub(r"[-_.]\d+$","",value)
    return re.sub(r"[^a-z0-9]+","",value)


def _direct_lan_networks():
    nets=[]
    raw=command_output(["ip","-4","route","show","scope","link"])
    for line in raw.splitlines():
        parts=line.split()
        if not parts:
            continue
        dev=""
        if "dev" in parts:
            try:
                dev=parts[parts.index("dev")+1]
            except (ValueError,IndexError):
                dev=""
        if dev=="tailscale0" or dev=="lo" or dev.startswith(("docker","br-","veth")):
            continue
        try:
            net=ipaddress.ip_network(parts[0],strict=False)
        except ValueError:
            continue
        if net.version==4 and _rfc1918_ipv4(str(net.network_address)):
            nets.append(net)
    return nets


def _is_direct_lan_ip(value,nets=None):
    if not _rfc1918_ipv4(value):
        return False
    nets=_direct_lan_networks() if nets is None else nets
    if not nets:
        return True
    ip=ipaddress.ip_address(value)
    return any(ip in net for net in nets)


def _private_ip_from_endpoint(value):
    value=(value or "").strip()
    if not value:
        return ""
    if value.startswith("["):
        host=value[1:].split("]",1)[0]
    else:
        host=value.rsplit(":",1)[0] if ":" in value else value
    return host if _rfc1918_ipv4(host) else ""


def tailscale_devices():
    raw=command_output(["tailscale","status","--json"])
    if not raw:
        return []
    try:
        data=json.loads(raw)
    except Exception:
        return []
    nodes=[]
    peers=data.get("Peer",{})
    if isinstance(peers,dict):
        nodes.extend(peers.values())
    elif isinstance(peers,list):
        nodes.extend(peers)
    out=[]
    for node in nodes:
        ips=[]
        for addr in node.get("TailscaleIPs") or []:
            try:
                ip=ipaddress.ip_address(addr)
            except ValueError:
                continue
            if ip.version==4:
                ips.append(str(ip))
        if not ips:
            continue
        dns=(node.get("DNSName") or "").rstrip(".")
        host=(node.get("HostName") or "").strip()
        name=host or (dns.split(".",1)[0] if dns else ips[0])
        lan=[]
        direct=_private_ip_from_endpoint(node.get("CurAddr"))
        if direct and _is_direct_lan_ip(direct):
            lan.append(direct)
        # Tailscale's JSON status calls known peer endpoints "Addrs".
        for endpoint in node.get("Addrs") or []:
            cand=_private_ip_from_endpoint(endpoint)
            if cand and _is_direct_lan_ip(cand) and cand not in lan:
                lan.append(cand)
        out.append({
            "name":name,
            "dns":dns,
            "tailscale_ips":ips,
            "lan_candidates":lan,
            "online":bool(node.get("Online",False)),
            "active":bool(node.get("Active",False)),
        })
    return sorted(out,key=lambda d:(not d["online"],d["name"].casefold()))


def recent_lan_clients():
    found={}
    local_nets=_direct_lan_networks()
    if FTL_DB.is_file():
        try:
            import sqlite3
            db=sqlite3.connect(f"file:{FTL_DB}?mode=ro",uri=True)
            db.row_factory=sqlite3.Row
            tables={r[0] for r in db.execute("SELECT name FROM sqlite_master WHERE type='table'")}
            if "network_addresses" in tables:
                cols={r[1] for r in db.execute("PRAGMA table_info(network_addresses)")}
                if "ip" in cols:
                    name_expr="name" if "name" in cols else "''"
                    seen_expr="lastSeen" if "lastSeen" in cols else "0"
                    q=f"SELECT ip,{name_expr} AS name,{seen_expr} AS lastSeen FROM network_addresses"
                    for row in db.execute(q):
                        ip=str(row["ip"] or "")
                        if not _is_direct_lan_ip(ip,local_nets):
                            continue
                        found[ip]={
                            "ip":ip,
                            "name":str(row["name"] or ""),
                            "last_seen":int(row["lastSeen"] or 0),
                            "source":"Pi-hole",
                        }
            db.close()
        except Exception:
            pass
    raw=command_output(["ip","neigh","show"])
    for line in raw.splitlines():
        parts=line.split()
        if not parts or not _is_direct_lan_ip(parts[0],local_nets):
            continue
        ip=parts[0]
        item=found.setdefault(ip,{"ip":ip,"name":"","last_seen":0,"source":"LAN"})
        if item["source"]!="Pi-hole":
            item["source"]="LAN"
    return sorted(found.values(),key=lambda d:(-d["last_seen"],tuple(int(x) for x in d["ip"].split("."))))


def _age_text(last_seen):
    if not last_seen:
        return "seen on LAN"
    age=max(0,int(time.time())-int(last_seen))
    if age<60:
        return "seen just now"
    if age<3600:
        return f"seen {age//60}m ago"
    if age<86400:
        return f"seen {age//3600}h ago"
    return f"seen {age//86400}d ago"


def _lan_label(item):
    extra=f"  {item['name']}" if item.get("name") else ""
    return f"{item['ip']:<15}{extra:<28} {_age_text(item.get('last_seen',0))}"


def _saved_profile_owners(address,exclude_path=None):
    owners=[]
    for other_path in M["pfiles"]():
        if exclude_path is not None and other_path==exclude_path:
            continue
        try:
            p=M["load"](other_path,CAT)
        except BaseException:
            continue
        if any(addr==address for addr,_ in p["clients"]):
            owners.append((other_path,p["name"]))
    return owners


def _remove_address_from_profile(path,address):
    vals=lines(path,"clients","entries")
    kept=[]
    changed=False
    for raw in vals:
        addr,sep,label=raw.partition("|")
        if addr.strip()==address:
            changed=True
            continue
        kept.append(raw)
    if changed:
        set_lines(path,"clients","entries",kept)
    return changed


def _save_linked_addresses(path,entries):
    current=lines(path,"clients","entries")
    parsed=[]
    for raw in current:
        addr,sep,label=raw.partition("|")
        parsed.append((addr.strip(),label.strip() if sep else ""))
    for address,label in entries:
        owners=_saved_profile_owners(address,path)
        if owners:
            names=", ".join(name for _,name in owners)
            if not confirm(f"{address} is already saved in:\n\n{names}\n\nMove it to this profile?"):
                continue
            for owner_path,_ in owners:
                _remove_address_from_profile(owner_path,address)
        parsed=[(a,l) for a,l in parsed if a!=address]
        parsed.append((address,label))
    set_lines(path,"clients","entries",[f"{a} | {l}" if l else a for a,l in parsed])


def _sync_after_link(path):
    c=menu("Device linked",[
        "Sync to Pi-hole now   recommended",
        "Save only             sync later",
    ],"The device addresses are saved in this profile.")
    if c==0:
        p=M["load"](path,CAT)
        def work():
            M["apply_one"](p,CAT)
            M["reload"](False)
        external("Sync device to Pi-hole",work)


def _choose_lan_client(candidates,title="Choose LAN address"):
    if not candidates:
        show_text(title,"No recent LAN clients were discovered by Pi-hole or the server neighbor table.")
        return None
    items=[_lan_label(x) for x in candidates]+["Skip LAN address","Back"]
    c=menu(title,items,"Most recently seen clients are listed first.")
    if c is None or c>=len(candidates):
        return None
    return candidates[c]["ip"]


def _auto_lan_for_tail_device(device,candidates):
    direct=[ip for ip in device.get("lan_candidates",[]) if _rfc1918_ipv4(ip)]
    if direct:
        return direct[0],"Tailscale direct connection"
    names={_norm_device_name(device.get("name")),_norm_device_name(device.get("dns"))}
    names.discard("")
    matches=[]
    for item in candidates:
        n=_norm_device_name(item.get("name"))
        if n and n in names:
            matches.append(item["ip"])
    if len(matches)==1:
        return matches[0],"matching LAN hostname"
    return "",""


def _refresh_tail_device(device):
    if device.get("lan_candidates") or not device.get("online"):
        return device
    tail_ip=(device.get("tailscale_ips") or [""])[0]
    if not tail_ip:
        return device
    try:
        subprocess.run(
            ["tailscale","ping","--c","1","--timeout=2s",tail_ip],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=4,
            check=False,
        )
    except Exception:
        return device
    for fresh in tailscale_devices():
        if tail_ip in fresh.get("tailscale_ips",[]):
            return fresh
    return device


def _find_tail_device_by_text(devices):
    value=prompt("Tailscale device name or MagicDNS name")
    if not value:
        return None
    needle=value.strip().rstrip(".").casefold()
    short=needle.split(".",1)[0]
    matches=[]
    for d in devices:
        vals={d["name"].casefold(),d["dns"].casefold(),d["dns"].split(".",1)[0].casefold() if d["dns"] else ""}
        if needle in vals or short in vals:
            matches.append(d)
    if len(matches)==1:
        return matches[0]
    if not matches:
        show_text("Device not found",f"No Tailscale device matched:\n\n{value}")
        return None
    c=menu("Choose Tailscale device",[f"{d['name']}  {d['dns']}  {d['tailscale_ips'][0]}" for d in matches])
    return None if c is None else matches[c]


def link_device(path):
    devices=tailscale_devices()
    choices=[]
    if devices:
        choices+=["Choose Tailscale device   recommended","Enter Tailscale / MagicDNS name"]
    choices+=["Choose LAN client only","Enter IP manually","Back"]
    c=menu("Add / link device",choices,"Link LAN + Tailscale identities to one Pi-hole profile without typing addresses when possible.")
    if c is None or c==len(choices)-1:
        return

    device=None
    offset=0
    if devices:
        if c==0:
            labels=[]
            for d in devices:
                state="online" if d["online"] else "offline"
                direct=f"  LAN {d['lan_candidates'][0]}" if d["lan_candidates"] else ""
                labels.append(f"{d['name']:<26} {d['tailscale_ips'][0]:<15} {state}{direct}")
            pick=menu("Choose Tailscale device",labels,"Tailscale name is enough; pihm will try to link its LAN address too.")
            if pick is None:
                return
            device=devices[pick]
        elif c==1:
            device=_find_tail_device_by_text(devices)
            if device is None:
                return
        offset=2

    if device is not None:
        device=_refresh_tail_device(device)
        candidates=recent_lan_clients()
        auto_ip,reason=_auto_lan_for_tail_device(device,candidates)
        tail_ip=device["tailscale_ips"][0]
        friendly=device["name"]
        if auto_ip:
            action=menu("Link device",[
                f"Link Tailscale + LAN   {tail_ip} + {auto_ip}   recommended",
                "Choose a different LAN address",
                f"Link Tailscale only   {tail_ip}",
                "Cancel",
            ],f"{friendly}: found {auto_ip} via {reason}.")
            if action is None or action==3:
                return
            if action==0:
                _save_linked_addresses(path,[
                    (tail_ip,f"{friendly} - Tailscale"),
                    (auto_ip,f"{friendly} - LAN"),
                ])
                _sync_after_link(path)
                return
            if action==2:
                _save_linked_addresses(path,[(tail_ip,f"{friendly} - Tailscale")])
                _sync_after_link(path)
                return
        lan_ip=_choose_lan_client(candidates,f"Choose LAN address for {friendly}")
        entries=[(tail_ip,f"{friendly} - Tailscale")]
        if lan_ip:
            entries.append((lan_ip,f"{friendly} - LAN"))
        _save_linked_addresses(path,entries)
        _sync_after_link(path)
        return

    choice_index=c-offset
    if choice_index==0:
        lan_ip=_choose_lan_client(recent_lan_clients())
        if lan_ip:
            _save_linked_addresses(path,[(lan_ip,f"LAN device {lan_ip}")])
            _sync_after_link(path)
        return
    if choice_index==1:
        address=prompt("Client IP address")
        if not address:
            return
        label=prompt("Optional label","") or ""
        _save_linked_addresses(path,[(address,label)])
        _sync_after_link(path)


def edit_clients(path):
    pos=0
    while True:
        vals=lines(path,"clients","entries")
        items=vals+[
            "+ Add / link device     discover Tailscale + LAN",
            "+ Add address manually",
            "Back",
        ]
        c=menu("Clients",items,"Recommended: Add / link device. pihm can discover Tailscale names and recent LAN addresses.",min(pos,len(items)-1))
        if c is None or c==len(items)-1:
            return
        pos=c
        if c==len(vals):
            link_device(path)
            continue
        if c==len(vals)+1:
            address=prompt("Client address (LAN IP, Tailscale IP, or CIDR)")
            if not address:
                continue
            label=prompt("Optional label","") or ""
            _save_linked_addresses(path,[(address,label)])
            continue
        raw=vals[c]
        address,sep,label=raw.partition("|")
        address=address.strip()
        label=label.strip() if sep else ""
        x=menu("Client",["Edit address","Edit label","Delete","Back"],raw)
        if x==0:
            n=prompt("Client address",address)
            address=n or address
        elif x==1:
            n=prompt("Client label",label)
            label=label if n is None else n
        elif x==2 and confirm(f"Remove {address} from this profile?"):
            vals.pop(c)
            set_lines(path,"clients","entries",vals)
            pos=max(0,c-1)
            continue
        else:
            continue
        vals[c]=f"{address} | {label}" if label else address
        set_lines(path,"clients","entries",vals)

def edit_lists(path):
    keys=list(CAT); pos=0
    while True:
        selected=set(lines(path,"lists","keys")); items=[]
        for k in keys: items.append(f"{'[x]' if k in selected else '[ ]'} {k:<16} {CAT[k][1]}")
        c=menu("Blocklists",items,"Enter toggles. Saved immediately to profile; Apply writes to Pi-hole.",pos,"Up/Down = move   Enter = toggle   q/Esc = back")
        if c is None: return
        pos=c; k=keys[c]
        if k in selected: selected.remove(k)
        else: selected.add(k)
        set_lines(path,"lists","keys",[k for k in keys if k in selected])


def apply(path,gravity=False):
    p=M["load"](path,CAT)
    action="Sync + refresh lists" if gravity else "Sync to Pi-hole"
    detail=(
        "This writes the profile's description, selected list assignments, allow/deny rules, "
        "blocked TLDs, clients, and configured Arachnidium proxy IP into live Pi-hole. "
        + ("It then downloads the latest contents from every enabled blocklist URL and rebuilds Gravity." if gravity else "It reloads DNS without downloading blocklist contents.")
    )
    if not confirm(f"{action} for {p['name']}?\n\n{detail}"):
        return
    def work():
        M["apply_one"](p,CAT); M["reload"](gravity)
    external(action,work)


def clone(path):
    p=M["load"](path,CAT); name=prompt("Clone profile as",p["name"]+" Copy")
    if not name: return None
    out=M["PROFILES"]/f"{M['slug'](name)}.ini"
    if out.exists(): show_text("Already exists",str(out)); return None
    shutil.copy2(path,out); c=cfg(out); c.set("profile","name",name); c.set("profile","description",f"Cloned from {p['name']}"); c.set("profile","default","false"); dump(c,out); return out


def live_group_description(name):
    try:
        db=M["con"]()
        row=db.execute('SELECT description FROM "group" WHERE name=?',(name,)).fetchone()
        db.close()
        return (row["description"] or "").strip() if row else ""
    except Exception:
        return ""


def edit_description(path,p):
    while True:
        live=live_group_description(p["name"])
        current=p["description"]
        items=[
            f"Edit description      {current}",
            f"Restore from Pi-hole  {live or '(no live description)'}",
