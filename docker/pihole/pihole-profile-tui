def update_pihm():
    candidates=[
        Path("/usr/local/bin/pihm-installer"),
        MANAGER.with_name("pihm-installer"),
    ]
    installer=next((p for p in candidates if p.is_file()),None)
    if installer is None:
        show_text(
            "Update pihm",
            "pihm-installer was not found. Re-run the one-time install command from the README.",
        )
        return

    clear()
    print(f"{BOLD}Update pihm{RESET}\n")
    print("Fetching and installing the latest files from omv-remote-dots main...\n")
    try:
        subprocess.run([str(installer),"update"],check=True)
    except subprocess.CalledProcessError as e:
        print(f"\n{RED}Update failed with status {e.returncode}.{RESET}")
        pause()
        return
    except OSError as e:
        print(f"\n{RED}Update failed:{RESET} {e}")
        pause()
        return

    print(f"\n{GREEN}Update complete.{RESET}")
    pause("Press any key to restart pihm...")
    os.execv(sys.executable,[sys.executable,str(MANAGER)])


