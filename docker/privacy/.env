# /docker/privacy/.env

# AirVPN Gluetun egress with two Tailscale Serve sidecars:
# transmission.time-puffin.ts.net
# mullvad.time-puffin.ts.net

COMPOSE_PROJECT_NAME=privacy

# General
TZ=America/New_York
PUID=1000
PGID=1000

# AirVPN / Gluetun Configuration
VPN_SERVICE_PROVIDER=airvpn
VPN_TYPE=wireguard

# Insert Data
WIREGUARD_PRIVATE_KEY=
WIREGUARD_PRESHARED_KEY=
WIREGUARD_ADDRESSES=
WIREGUARD_ENDPOINT_PORT=1637
SERVER_COUNTRIES=United States

# Ports allowed into Gluetun from the Docker bridge.
# 9091 = Transmission WebUI
# 3000 = Mullvad Browser HTTP backend
GLUETUN_FIREWALL_INPUT_PORTS=9091,3000

# AirVPN forwarded port.
# Transmission itself must also be configured to listen on this same peer port.
AIRVPN_FORWARDED_PORT=25045

# Optional host-side mapping. This does not create the AirVPN forward by itself.
TRANSMISSION_HOST_SEED_PORT=51413

# Transmission Configuration
TRANSMISSION_IMAGE_URL=lscr.io/linuxserver/transmission:latest
TRANSMISSION_SERVICEPORT=9091
TRANSMISSION_USER=user
TRANSMISSION_PASS=password

# Transmission Tailscale Configuration
TS_AUTHKEY_TRANSMISSION=

# Mullvad Browser Configuration
MULLVAD_IMAGE_URL=lscr.io/linuxserver/mullvad-browser:latest

# LinuxServer Mullvad Browser default HTTP backend port is 3000.
# Tailscale terminates HTTPS on 443 and proxies to this internal HTTP port.
MULLVAD_SERVICEPORT=3000
MULLVAD_USER=user
MULLVAD_PASS=password

# Mullvad Browser Tailscale Configuration
TS_AUTHKEY_MULLVAD=