# /docker/seerr/.env

COMPOSE_PROJECT_NAME=seerr

# Service Configuration
SERVICE=seerr
IMAGE_URL=ghcr.io/seerr-team/seerr:v3.5.0
SERVICEPORT=5055

# Tailscale Configuration (use an existing node's state when migrating)
# TS_AUTHKEY=tskey-client-xxxxxxxxxxxxxxxx
TS_AUTHKEY=

# App / DB Configuration
TZ=America/New_York
DB_TYPE=sqlite

# Host Paths (relative to /docker/seerr)
SEERR_CONFIG_PATH=./seerr/config
