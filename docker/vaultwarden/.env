# /docker/vaultwarden/.env

COMPOSE_PROJECT_NAME=vaultwarden

# Service Configuration
SERVICE=vaultwarden
IMAGE_URL=vaultwarden/server:latest

# Vaultwarden listens on 80 by default inside the container
SERVICEPORT=80

# Tailscale Configuration
# Example:
# TS_AUTHKEY=tskey-client-xxxxxxxxxxxxxxxx
TS_AUTHKEY=

# Vaultwarden Configuration
# Not strictly required for basic use, but recommended for correct links/origin behavior
DOMAIN=

# Optional
TZ=America/New_York
PUID=1000
PGID=1000